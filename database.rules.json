{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'demonalexander526@gmail.com' || auth.token.email === 'alexhack235@gmail.com')"
      }
    },
    "conversations": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "typing": {
      "$chatId": {
        ".read": "auth != null && $chatId.contains(auth.uid)",
        ".write": "auth != null && $chatId.contains(auth.uid)"
      }
    },
    "status": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "calls": {
      "$callId": {
        ".read": "auth != null && (data.child('callerUid').val() === auth.uid || data.child('recipientUid').val() === auth.uid || $callId.contains(auth.uid))",
        ".write": "auth != null && (data.child('callerUid').val() === auth.uid || data.child('recipientUid').val() === auth.uid || $callId.contains(auth.uid) || !data.exists())"
      }
    }
  }
}
