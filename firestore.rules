rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Models & Schemas
    // ===============================================================
    //
    // Collection: users
    // Document ID: {uid} (Firebase Auth UID)
    // Fields:
    //   - uid: string (required on create/update, immutable)
    //   - email: string (optional, max 255 chars)
    //   - username: string (optional, max 100 chars)
    //   - displayName: string (optional, max 100 chars)
    //   - photoURL / avatar: string (optional URL, max 2048 chars)
    //   - bio: string (optional, max 1000 chars)
    //   - tokens: number (optional, user token balance, anti-privilege escalation)
    //   - online: bool (optional)
    //   - lastSeen: timestamp (optional)
    //   - createdAt: timestamp (optional, immutable)
    //   - isAdmin / isSuperAdmin / role / banned: privileged flags (superAdmin only)
    //   - blockedUsers / mutedUsers / archivedChats: list of strings (max 500 items)
    //   - ipAddresses / knownIps / recentIps / clientIps / detectedIps / verifiedIps: list of strings (max 4 IP addresses, each max 45 chars)
    //   - ipAddress / lastIp: string (optional, max 45 chars)
    // Subcollection: linkedDevices/{deviceId}
    //   - deviceId: string (required/optional, max 128 chars)
    //   - deviceName: string (optional, max 128 chars)
    //   - platform: string (optional, max 64 chars)
    //   - ipAddress / lastIp: string (optional, max 45 chars)
    //   - ipAddresses / knownIps / recentIps / clientIps / detectedIps / verifiedIps: list of strings (max 4 IP addresses)
    //   - linkedAt: timestamp/number (optional)
    // Subcollection: authorized_extensions/{extensionId}
    //   - extensionId: string (1 to 64 chars, immutable)
    //   - status: string (required, 'approved' | 'denied' | 'pending')
    //   - scopes: list of strings (optional, max 10 items, each scope max 64 chars)
    //   - timestamp / updatedAt / createdAt: timestamp/string/number (optional)
    //   - ipAddress: string (optional, max 45 chars)
    //   - extensionName: string (optional, max 128 chars)
    //
    // Collection: messages
    // Document ID: {messageId} (Auto-generated)
    // Fields:
    //   - from / senderId: string (required, sender UID, immutable)
    //   - to / receiverId: string (required, recipient UID, immutable)
    //   - text / content: string (optional, max 10000 chars)
    //   - status: string (optional, e.g. 'sent', 'delivered', 'read')
    //   - read: bool (optional)
    //   - readAt: timestamp/number/string (optional)
    //   - reactions: list (optional, max 100 items)
    //   - attachment: map or string URL (optional)
    //   - createdAt / timestamp: timestamp (optional, immutable)
    //
    // Collection: groups
    // Document ID: {groupId} (Auto-generated)
    // Fields:
    //   - creatorId: string (required, immutable)
    //   - name: string (required, max 128 chars)
    //   - description: string (optional, max 1000 chars)
    //   - members: list of strings (required, group member UIDs, max 1000 items)
    //   - admins: list of strings (required, group admin UIDs, max 100 items)
    //   - moderators: list of strings (optional, max 100 items)
    // Subcollection: messages/{msgId}
    //   - senderId / from: string (required, sender UID, immutable)
    //   - text / content: string (optional, max 10000 chars)
    //   - reactions: list (optional, max 100 items)
    //   - readBy / readAt: list/map (optional)
    //
    // Collection: statuses
    // Document ID: {statusId} (Auto-generated)
    // Fields:
    //   - userId: string (required, creator UID, immutable)
    //   - content / caption: string (optional, max 2000 chars)
    //   - mediaUrl / imageUrl: string (optional URL, max 2048 chars)
    //   - type: string (optional, 'image' | 'video' | 'text')
    //   - expiresAtMs: int (optional, max 24h + 5m grace period, immutable)
    //   - expiresAt: timestamp/string (optional, max 24h + 5m grace period, immutable)
    //   - views / viewCount / viewsCount: interaction tracking
    //
    // Collection: reels
    // Document ID: {reelId} (Auto-generated)
    // Fields:
    //   - authorId / userId: string (required, author UID, immutable)
    //   - caption: string (optional, max 2000 chars)
    //   - videoUrl: string (required URL, max 2048 chars)
    //   - thumbnailUrl: string (optional URL, max 2048 chars)
    //   - sound: string (optional, max 200 chars)
    //   - access: string (optional, 'public' | 'private')
    //   - likes / likesCount / commentsCount / views / sharesCount / tokensTipped: interaction fields
    // Subcollection: comments/{commentId}
    //   - authorId / userId: string (required, commenter UID, immutable)
    //   - text: string (required, 1 to 1000 chars)
    // Subcollection: likes/{likeId}
    //   - userId: string (required, liker UID)
    //
    // Collection: nexbot_configs
    // Document ID: {configId} (Auto-generated)
    // Fields:
    //   - authorId / userId / uid: string (required, author UID, immutable)
    //   - name: string (required, 1 to 100 chars)
    //   - description: string (optional, max 1000 chars)
    //   - systemPrompt / instructions: string (optional, max 15000 chars)
    //   - model: string (optional, max 100 chars)
    //   - avatar: string (optional URL, max 2048 chars)
    //   - isPublished / published / status: bool/string (public visibility flag)
    //
    // Collection: security_scan_logs
    // Document ID: {logId} (Auto-generated)
    // Fields:
    //   - userId / ownerId / uid: string (required, scanner user UID, immutable)
    //   - scanType: string (optional, max 100 chars)
    //   - status: string (optional, max 50 chars)
    //   - findings / summary: string (optional, max 5000 chars)
    //   - ipAddress / lastIp: string (optional, max 45 chars)
    //   - ipAddresses / knownIps / recentIps / clientIps / detectedIps / verifiedIps: list of strings (max 4 IP addresses, each max 45 chars)
    //   - timestamp: timestamp/number (optional)
    //
    // Collection: quarantine_vault
    // Document ID: {vaultId} (Auto-generated)
    // Fields:
    //   - userId / ownerId / uid: string (required, owner UID, immutable)
    //   - fileName: string (optional, max 255 chars)
    //   - fileUrl: string (optional URL, max 2048 chars)
    //   - threatLevel / reason: string (optional, max 1000 chars)
    //
    // Collection: call_sessions & calls
    // Document ID: {callId} (Auto-generated)
    // Fields:
    //   - callerId: string (required, initiator UID, immutable)
    //   - receiverId: string (optional, target UID)
    //   - participants: list of strings (optional, participant UIDs, max 50 items)
    //   - callType: string (optional, 'voice' | 'video', max 50 chars)
    //   - status: string (optional, 'ringing' | 'connected' | 'ended' | 'rejected', max 50 chars)
    //
    // Collection: tokens & vip_licenses
    // Document ID: {tokenId} / {licenseId}
    // Fields:
    //   - userId / ownerId / holderId: string (required)
    //   - balance / tokens: number
    //   - licenseKey / tier / status: string (optional)
    // ===============================================================

    // ===============================================================
    // CORE SECURITY & VALIDATION HELPER FUNCTIONS
    // ===============================================================

    // 1. Authenticated User Check
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // 2. Resource Owner Check by User ID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 3. Super Admin Verification (Bootstrap email, token claim, or admins collection)
    function isSuperAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email == 'demonalexander526@gmail.com' && request.auth.token.email_verified == true) ||
        request.auth.token.admin == true ||
        request.auth.uid == 'demonalexander526' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 4. Group Membership Verification (Safely checks existence and members array)
    function isGroupMember(groupId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/groups/$(groupId)) &&
             'members' in get(/databases/$(database)/documents/groups/$(groupId)).data &&
             request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    // 5. Group Admin Verification (Admins list, group creator, or SuperAdmin)
    function isGroupAdmin(groupId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/groups/$(groupId)) &&
             (
               ('admins' in get(/databases/$(database)/documents/groups/$(groupId)).data &&
                request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.admins) ||
               request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.creatorId ||
               isSuperAdmin()
             );
    }

    // 6. Group Moderator Verification (Admin OR Moderator)
    function isGroupModerator(groupId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/groups/$(groupId)) &&
             (
               isGroupAdmin(groupId) ||
               (
                 'moderators' in get(/databases/$(database)/documents/groups/$(groupId)).data &&
                 request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.moderators
               )
             );
    }

    // 7. String Validation Helper (Non-empty with length limits)
    function validStringLength(field, minLen, maxLen) {
      return field in request.resource.data &&
             request.resource.data[field] is string &&
             request.resource.data[field].size() >= minLen &&
             request.resource.data[field].size() <= maxLen;
    }

    // 8. Optional String Validation Helper (If present, must be string within limits)
    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
             request.resource.data[field] == null ||
             (request.resource.data[field] is string &&
              request.resource.data[field].size() >= minLen &&
              request.resource.data[field].size() <= maxLen);
    }

    // 9. URL Format Validation
    function isValidUrl(url) {
      return url is string &&
             url.size() <= 2048 &&
             (url.matches("^https?://.*") || url.matches("^data:image/.*") || url == "");
    }

    // 10. Optional URL Validation
    function isValidOptionalUrl(field) {
      return !(field in request.resource.data) ||
             request.resource.data[field] == null ||
             isValidUrl(request.resource.data[field]);
    }

    // 11. List Size Validation Helper
    function isValidList(val, maxSize) {
      return val is list && val.size() <= maxSize;
    }

    // 12. Optional List Size Validation Helper
    function isValidOptionalList(field, maxSize) {
      return !(field in request.resource.data) ||
             request.resource.data[field] == null ||
             isValidList(request.resource.data[field], maxSize);
    }

    // 13. IP Address List Validation Helper (Enforces array/list cap: max 4 IP addresses, each max 45 chars string)
    function isValidIpList(field, maxCount) {
      return !(field in request.resource.data) ||
             request.resource.data[field] == null ||
             (request.resource.data[field] is list &&
              request.resource.data[field].size() <= maxCount &&
              (request.resource.data[field].size() < 1 || (request.resource.data[field][0] is string && request.resource.data[field][0].size() <= 45)) &&
              (request.resource.data[field].size() < 2 || (request.resource.data[field][1] is string && request.resource.data[field][1].size() <= 45)) &&
              (request.resource.data[field].size() < 3 || (request.resource.data[field][2] is string && request.resource.data[field][2].size() <= 45)) &&
              (request.resource.data[field].size() < 4 || (request.resource.data[field][3] is string && request.resource.data[field][3].size() <= 45)));
    }

    // 14. Immutable Field Check
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // 15. Extension Hub Scopes Validator (Max 10 scopes, each string max 64 chars)
    function isValidScopeList(scopes) {
      return scopes is list &&
             scopes.size() <= 10 &&
             (scopes.size() < 1 || (scopes[0] is string && scopes[0].size() <= 64)) &&
             (scopes.size() < 2 || (scopes[1] is string && scopes[1].size() <= 64)) &&
             (scopes.size() < 3 || (scopes[2] is string && scopes[2].size() <= 64)) &&
             (scopes.size() < 4 || (scopes[3] is string && scopes[3].size() <= 64)) &&
             (scopes.size() < 5 || (scopes[4] is string && scopes[4].size() <= 64)) &&
             (scopes.size() < 6 || (scopes[5] is string && scopes[5].size() <= 64)) &&
             (scopes.size() < 7 || (scopes[6] is string && scopes[6].size() <= 64)) &&
             (scopes.size() < 8 || (scopes[7] is string && scopes[7].size() <= 64)) &&
             (scopes.size() < 9 || (scopes[8] is string && scopes[8].size() <= 64)) &&
             (scopes.size() < 10 || (scopes[9] is string && scopes[9].size() <= 64));
    }

    // 16. Flexible Timestamp / String / Number validator helper
    function isValidTimestampOrNumber(val) {
      return val == null || val is timestamp || val is string || val is int || val is float || val is number;
    }

    // ===============================================================
    // DOMAIN VALIDATORS (Validator Function Pattern)
    // ===============================================================

    // User Profile Validator: Prevents privilege escalation on isAdmin, isSuperAdmin, role, banned, and tokens; enforces max 4 IPs
    function isValidUserCreate(data) {
      return (!('isAdmin' in data) || data.isAdmin == false || isSuperAdmin()) &&
             (!('isSuperAdmin' in data) || data.isSuperAdmin == false || isSuperAdmin()) &&
             (!('role' in data) || data.role in ['user', 'member', 'client', 'guest'] || isSuperAdmin()) &&
             (!('banned' in data) || data.banned == false || isSuperAdmin()) &&
             (!('tokens' in data) || (data.tokens is number && data.tokens >= 0 && data.tokens <= 2000) || isSuperAdmin()) &&
             isValidOptionalString('username', 0, 100) &&
             isValidOptionalString('displayName', 0, 100) &&
             isValidOptionalString('bio', 0, 1000) &&
             isValidOptionalString('email', 0, 255) &&
             isValidOptionalUrl('photoURL') &&
             isValidOptionalUrl('avatar') &&
             isValidOptionalList('blockedUsers', 500) &&
             isValidOptionalList('mutedUsers', 500) &&
             isValidOptionalList('archivedChats', 500) &&
             isValidOptionalString('ipAddress', 0, 45) &&
             isValidOptionalString('lastIp', 0, 45) &&
             isValidIpList('ipAddresses', 4) &&
             isValidIpList('knownIps', 4) &&
             isValidIpList('recentIps', 4) &&
             isValidIpList('clientIps', 4) &&
             isValidIpList('detectedIps', 4) &&
             isValidIpList('verifiedIps', 4);
    }

    function isValidUserUpdate(data, prev) {
      return (!('isAdmin' in data) || (('isAdmin' in prev && data.isAdmin == prev.isAdmin) || (!('isAdmin' in prev) && data.isAdmin == false)) || isSuperAdmin()) &&
             (!('isSuperAdmin' in data) || (('isSuperAdmin' in prev && data.isSuperAdmin == prev.isSuperAdmin) || (!('isSuperAdmin' in prev) && data.isSuperAdmin == false)) || isSuperAdmin()) &&
             (!('role' in data) || (('role' in prev && data.role == prev.role) || (!('role' in prev) && data.role in ['user', 'member', 'client', 'guest'])) || isSuperAdmin()) &&
             (!('banned' in data) || (('banned' in prev && data.banned == prev.banned) || (!('banned' in prev) && data.banned == false)) || isSuperAdmin()) &&
             (!('tokens' in data) || (data.tokens is number && data.tokens >= 0 && (('tokens' in prev && data.tokens <= prev.tokens) || (!('tokens' in prev) && data.tokens <= 2000))) || isSuperAdmin()) &&
             (!('uid' in data) || !('uid' in prev) || data.uid == prev.uid) &&
             isValidOptionalString('username', 0, 100) &&
             isValidOptionalString('displayName', 0, 100) &&
             isValidOptionalString('bio', 0, 1000) &&
             isValidOptionalString('email', 0, 255) &&
             isValidOptionalUrl('photoURL') &&
             isValidOptionalUrl('avatar') &&
             isValidOptionalList('blockedUsers', 500) &&
             isValidOptionalList('mutedUsers', 500) &&
             isValidOptionalList('archivedChats', 500) &&
             isValidOptionalString('ipAddress', 0, 45) &&
             isValidOptionalString('lastIp', 0, 45) &&
             isValidIpList('ipAddresses', 4) &&
             isValidIpList('knownIps', 4) &&
             isValidIpList('recentIps', 4) &&
             isValidIpList('clientIps', 4) &&
             isValidIpList('detectedIps', 4) &&
             isValidIpList('verifiedIps', 4);
    }

    // Extension Hub Authorized Extension Validator: Schema validation for /users/{uid}/authorized_extensions/{extensionId}
    function isValidAuthorizedExtension(data, extId) {
      return extId is string &&
             extId.size() >= 1 && extId.size() <= 64 &&
             (!('extensionId' in data) || (data.extensionId is string && data.extensionId.size() >= 1 && data.extensionId.size() <= 64 && data.extensionId == extId)) &&
             ('status' in data && data.status is string && data.status in ['approved', 'denied', 'pending']) &&
             (!('scopes' in data) || data.scopes == null || isValidScopeList(data.scopes)) &&
             (!('timestamp' in data) || isValidTimestampOrNumber(data.timestamp)) &&
             (!('updatedAt' in data) || isValidTimestampOrNumber(data.updatedAt)) &&
             (!('createdAt' in data) || isValidTimestampOrNumber(data.createdAt)) &&
             isValidOptionalString('ipAddress', 0, 45) &&
             isValidOptionalString('extensionName', 0, 128);
    }

    // Direct Message Validator
    function isValidMessageCreate(data) {
      return (
               (('from' in data && data.from == request.auth.uid) && ('to' in data && data.to is string && data.to.size() <= 128)) ||
               (('senderId' in data && data.senderId == request.auth.uid) && ('receiverId' in data && data.receiverId is string && data.receiverId.size() <= 128))
             ) &&
             isValidOptionalString('text', 0, 10000) &&
             isValidOptionalString('content', 0, 10000) &&
             isValidOptionalList('reactions', 100);
    }

    // Nexbot Studio Bot Config Validator
    function isValidNexbotConfig(data) {
      return (
               ('authorId' in data && data.authorId == request.auth.uid) ||
               ('userId' in data && data.userId == request.auth.uid) ||
               ('uid' in data && data.uid == request.auth.uid) ||
               isSuperAdmin()
             ) &&
             validStringLength('name', 1, 100) &&
             isValidOptionalString('description', 0, 1000) &&
             isValidOptionalString('systemPrompt', 0, 15000) &&
             isValidOptionalString('instructions', 0, 15000) &&
             isValidOptionalString('model', 0, 100) &&
             isValidOptionalUrl('avatar');
    }

    // Security Scanner Log Validator (Enforces max 4 detected/stored IP addresses)
    function isValidSecurityScanLog(data) {
      return (
               ('userId' in data && data.userId == request.auth.uid) ||
               ('ownerId' in data && data.ownerId == request.auth.uid) ||
               ('uid' in data && data.uid == request.auth.uid) ||
               isSuperAdmin()
             ) &&
             isValidOptionalString('scanType', 0, 100) &&
             isValidOptionalString('status', 0, 50) &&
             isValidOptionalString('findings', 0, 5000) &&
             isValidOptionalString('summary', 0, 5000) &&
             isValidOptionalString('ipAddress', 0, 45) &&
             isValidOptionalString('lastIp', 0, 45) &&
             isValidIpList('ipAddresses', 4) &&
             isValidIpList('knownIps', 4) &&
             isValidIpList('recentIps', 4) &&
             isValidIpList('clientIps', 4) &&
             isValidIpList('detectedIps', 4) &&
             isValidIpList('verifiedIps', 4);
    }

    // Quarantine Vault Item Validator
    function isValidQuarantineVault(data) {
      return (
               ('userId' in data && data.userId == request.auth.uid) ||
               ('ownerId' in data && data.ownerId == request.auth.uid) ||
               ('uid' in data && data.uid == request.auth.uid) ||
               isSuperAdmin()
             ) &&
             isValidOptionalString('fileName', 0, 255) &&
             isValidOptionalString('reason', 0, 1000) &&
             isValidOptionalString('threatLevel', 0, 50) &&
             isValidOptionalUrl('fileUrl');
    }

    // Reel Short Video Validator
    function isValidReel(data) {
      return (
               ('authorId' in data && data.authorId == request.auth.uid) ||
               ('userId' in data && data.userId == request.auth.uid) ||
               isSuperAdmin()
             ) &&
             isValidOptionalString('caption', 0, 2000) &&
             isValidOptionalUrl('videoUrl') &&
             isValidOptionalUrl('thumbnailUrl') &&
             isValidOptionalString('sound', 0, 200) &&
             isValidOptionalList('likes', 10000);
    }

    // WebRTC Call Session Validator
    function isValidCallSession(data) {
      return (
               ('callerId' in data && data.callerId == request.auth.uid) ||
               ('receiverId' in data && data.receiverId == request.auth.uid) ||
               ('participants' in data && data.participants is list && request.auth.uid in data.participants) ||
               isSuperAdmin()
             ) &&
             isValidOptionalString('callType', 0, 50) &&
             isValidOptionalString('status', 0, 50) &&
             isValidOptionalList('participants', 50);
    }

    // ===============================================================
    // 1. USERS COLLECTION & LINKED DEVICES & EXTENSIONS
    // ===============================================================
    match /users/{uid} {
      // Authenticated users can read directory profiles for contacts/chat (unauthenticated denied)
      allow read: if isAuthenticated();

      // Creation restricted to owner with anti-privilege escalation & payload bounds
      allow create: if isOwner(uid) && isValidUserCreate(request.resource.data);

      // Updates restricted to owner or SuperAdmin, protecting privileged flags; allows contact approvals
      allow update: if (isOwner(uid) && isValidUserUpdate(request.resource.data, resource.data)) ||
                       (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvedChatUsers']) && isValidOptionalList('approvedChatUsers', 1000)) ||
                       isSuperAdmin();

      // Account deletion restricted to SuperAdmin
      allow delete: if isSuperAdmin();

      // Linked Devices subcollection (Multi-device pairing with max 4 stored IP addresses)
      match /linkedDevices/{deviceId} {
        allow read: if isOwner(uid) || isSuperAdmin();
        allow create, update: if (isOwner(uid) || isSuperAdmin()) &&
                                 isValidOptionalString('deviceId', 0, 128) &&
                                 isValidOptionalString('deviceName', 0, 128) &&
                                 isValidOptionalString('platform', 0, 64) &&
                                 isValidOptionalString('ipAddress', 0, 45) &&
                                 isValidOptionalString('lastIp', 0, 45) &&
                                 isValidIpList('ipAddresses', 4) &&
                                 isValidIpList('knownIps', 4) &&
                                 isValidIpList('recentIps', 4) &&
                                 isValidIpList('clientIps', 4) &&
                                 isValidIpList('detectedIps', 4) &&
                                 isValidIpList('verifiedIps', 4);
        allow delete: if isOwner(uid) || isSuperAdmin();
      }

      // Extension Hub Authorized Extensions subcollection (Owner-only with strict schema validation)
      match /authorized_extensions/{extensionId} {
        allow read: if isOwner(uid) || isSuperAdmin();
        allow create: if (isOwner(uid) || isSuperAdmin()) &&
                         isValidAuthorizedExtension(request.resource.data, extensionId);
        allow update: if (isOwner(uid) || isSuperAdmin()) &&
                         areImmutableFieldsUnchanged(['extensionId', 'createdAt']) &&
                         isValidAuthorizedExtension(request.resource.data, extensionId);
        allow delete: if isOwner(uid) || isSuperAdmin();
      }
    }

    // ===============================================================
    // 2. DIRECT MESSAGES (End-to-End Privacy, Delivery Ticks & Reactions)
    // ===============================================================
    match /messages/{messageId} {
      // Read access restricted to conversation participants or SuperAdmin
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.from ||
        request.auth.uid == resource.data.to ||
        ('senderId' in resource.data && request.auth.uid == resource.data.senderId) ||
        ('receiverId' in resource.data && request.auth.uid == resource.data.receiverId) ||
        isSuperAdmin()
      );

      // Create: supports both from/to and senderId/receiverId schemas with data validation (text <= 10000, reactions <= 100)
      allow create: if isAuthenticated() && isValidMessageCreate(request.resource.data);

      // Update:
      // - Sender can edit message text or reactions (immutable sender/receiver/timestamps protected)
      // - Recipient can ONLY update delivery ticks (sent, delivered, read), status, and reactions
      // - SuperAdmin can manage or moderate
      allow update: if isAuthenticated() && (
        (
          (request.auth.uid == resource.data.from || ('senderId' in resource.data && request.auth.uid == resource.data.senderId)) &&
          areImmutableFieldsUnchanged(['from', 'to', 'senderId', 'receiverId', 'createdAt', 'timestamp']) &&
          isValidOptionalString('text', 0, 10000) &&
          isValidOptionalString('content', 0, 10000) &&
          isValidOptionalList('reactions', 100)
        ) ||
        (
          (request.auth.uid == resource.data.to || ('receiverId' in resource.data && request.auth.uid == resource.data.receiverId)) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'read', 'readAt', 'delivered', 'deliveredAt', 'reactions']) &&
          isValidOptionalList('reactions', 100)
        ) ||
        isSuperAdmin()
      );

      // Delete: sender, recipient, or SuperAdmin
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.from ||
        request.auth.uid == resource.data.to ||
        ('senderId' in resource.data && request.auth.uid == resource.data.senderId) ||
        ('receiverId' in resource.data && request.auth.uid == resource.data.receiverId) ||
        isSuperAdmin()
      );
    }

    // ===============================================================
    // 3. GROUP MESSAGES (Top-Level & Nested Subcollections)
    // ===============================================================
    match /groupMessages/{messageId} {
      allow read: if isAuthenticated() && (
        isGroupMember(resource.data.groupId) ||
        isSuperAdmin()
      );

      allow create: if isAuthenticated() &&
                       request.resource.data.groupId is string &&
                       isGroupMember(request.resource.data.groupId) &&
                       (request.resource.data.from == request.auth.uid || request.resource.data.senderId == request.auth.uid) &&
                       isValidOptionalString('text', 0, 10000) &&
                       isValidOptionalString('content', 0, 10000) &&
                       isValidOptionalList('reactions', 100);

      // Sender can edit text/reactions; group members can ONLY update reactions/readBy; moderators can moderate
      allow update: if isAuthenticated() && (
        (
          (request.auth.uid == resource.data.from || request.auth.uid == resource.data.senderId) &&
          areImmutableFieldsUnchanged(['from', 'senderId', 'groupId', 'createdAt', 'timestamp']) &&
          isValidOptionalString('text', 0, 10000) &&
          isValidOptionalString('content', 0, 10000) &&
          isValidOptionalList('reactions', 100)
        ) ||
        isGroupModerator(resource.data.groupId) ||
        (
          isGroupMember(resource.data.groupId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'readBy', 'readAt']) &&
          isValidOptionalList('reactions', 100)
        ) ||
        isSuperAdmin()
      );

      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.from ||
        request.auth.uid == resource.data.senderId ||
        isGroupModerator(resource.data.groupId) ||
        isSuperAdmin()
      );
    }

    // ===============================================================
    // 4. GROUPS
    // ===============================================================
    match /groups/{groupId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() &&
                       request.resource.data.creatorId == request.auth.uid &&
                       request.auth.uid in request.resource.data.members &&
                       request.auth.uid in request.resource.data.admins &&
                       validStringLength('name', 1, 128) &&
                       isValidOptionalString('description', 0, 1000) &&
                       isValidList(request.resource.data.members, 1000) &&
                       isValidList(request.resource.data.admins, 100);

      allow update: if isAuthenticated() && (
        (
          isGroupAdmin(groupId) &&
          areImmutableFieldsUnchanged(['creatorId', 'createdAt']) &&
          isValidOptionalString('name', 1, 128) &&
          isValidOptionalString('description', 0, 1000) &&
          isValidOptionalList('members', 1000) &&
          isValidOptionalList('admins', 100)
        ) ||
        (isGroupModerator(groupId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinnedMessages'])) ||
        (isGroupMember(groupId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'lastMessage', 'lastMessageTime', 'lastSender', 'pinnedMessages'])) ||
        isSuperAdmin()
      );

      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.creatorId ||
        isSuperAdmin()
      );

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (isGroupMember(groupId) || isSuperAdmin());
        allow create: if isAuthenticated() && isGroupMember(groupId) &&
                         (request.resource.data.senderId == request.auth.uid || request.resource.data.from == request.auth.uid) &&
                         isValidOptionalString('text', 0, 10000) &&
                         isValidOptionalString('content', 0, 10000) &&
                         isValidOptionalList('reactions', 100);
        allow update: if isAuthenticated() && (
          (
            (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.from) &&
            areImmutableFieldsUnchanged(['senderId', 'from', 'createdAt', 'timestamp']) &&
            isValidOptionalString('text', 0, 10000) &&
            isValidOptionalString('content', 0, 10000) &&
            isValidOptionalList('reactions', 100)
          ) ||
          isGroupAdmin(groupId) ||
          (
            isGroupMember(groupId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'readBy', 'readAt']) &&
            isValidOptionalList('reactions', 100)
          ) ||
          isSuperAdmin()
        );
        allow delete: if isAuthenticated() && (
          request.auth.uid == resource.data.senderId ||
          request.auth.uid == resource.data.from ||
          isGroupAdmin(groupId) ||
          isSuperAdmin()
        );
      }

      match /documents/{documentId} {
        allow read: if isAuthenticated() && (isGroupMember(groupId) || isSuperAdmin());
        allow create: if isAuthenticated() && isGroupMember(groupId) && request.resource.data.uploadedBy == request.auth.uid;
        allow update, delete: if isAuthenticated() && (request.auth.uid == resource.data.uploadedBy || isGroupAdmin(groupId) || isSuperAdmin());
      }

      match /sharedMedia/{mediaId} {
        allow read: if isAuthenticated() && (isGroupMember(groupId) || isSuperAdmin());
        allow create: if isAuthenticated() && isGroupMember(groupId) && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isAuthenticated() && (request.auth.uid == resource.data.senderId || isGroupAdmin(groupId) || isSuperAdmin());
      }
    }

    // ===============================================================
    // 5. NEX-STATUS (Ephemeral Stories, Media URLs, Views & 24h Purge)
    // ===============================================================
    match /statuses/{statusId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       (
                         !('expiresAtMs' in request.resource.data) ||
                         (request.resource.data.expiresAtMs is int &&
                          request.resource.data.expiresAtMs <= request.time.toMillis() + 86400000 + 300000 &&
                          request.resource.data.expiresAtMs >= request.time.toMillis() - 300000)
                       ) &&
                       (
                         !('expiresAt' in request.resource.data) ||
                         request.resource.data.expiresAt is timestamp ||
                         request.resource.data.expiresAt is string
                       ) &&
                       isValidOptionalString('content', 0, 2000) &&
                       isValidOptionalString('caption', 0, 2000) &&
                       isValidOptionalUrl('imageUrl') &&
                       isValidOptionalUrl('mediaUrl');

      // Author/Admin can update their status; viewers can record views without modifying author content
      allow update: if isAuthenticated() && (
        (
          isOwner(resource.data.userId) &&
          areImmutableFieldsUnchanged(['userId', 'createdAt', 'expiresAtMs', 'expiresAt']) &&
          isValidOptionalString('content', 0, 2000) &&
          isValidOptionalString('caption', 0, 2000)
        ) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'viewCount', 'viewsCount'])) ||
        isSuperAdmin()
      );

      // Auto-purge or author/admin deletion once expired or owner-initiated
      allow delete: if isAuthenticated() && (
        isOwner(resource.data.userId) ||
        isSuperAdmin() ||
        (resource.data.expiresAtMs is int && resource.data.expiresAtMs <= request.time.toMillis())
      );

      match /views/{viewId} {
        allow read: if isAuthenticated() && (isOwner(get(/databases/$(database)/documents/statuses/$(statusId)).data.userId) || isSuperAdmin());
        allow create: if isAuthenticated() && (request.resource.data.viewerId == request.auth.uid || request.resource.data.userId == request.auth.uid);
      }
    }

    // ===============================================================
    // 6. NEX-REELS (Short Video Feed, Comments & Likes)
    // ===============================================================
    match /reels/{reelId} {
      // Intentional public read for short video feed
      allow read: if true;

      allow create: if isAuthenticated() && isValidReel(request.resource.data);

      // Author or SuperAdmin can update reel details; authenticated users can update engagement counters/likes/tips
      allow update: if isAuthenticated() && (
        (
          (request.auth.uid == resource.data.authorId || request.auth.uid == resource.data.userId) &&
          areImmutableFieldsUnchanged(['authorId', 'userId', 'createdAt']) &&
          isValidReel(request.resource.data)
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likesCount', 'commentsCount', 'views', 'sharesCount', 'poll', 'tokensTipped']) &&
          isValidOptionalList('likes', 10000)
        ) ||
        isSuperAdmin()
      );

      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.authorId ||
        request.auth.uid == resource.data.userId ||
        isSuperAdmin()
      );

      // Reel Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() &&
                         (request.resource.data.authorId == request.auth.uid || request.resource.data.userId == request.auth.uid) &&
                         validStringLength('text', 1, 1000);
        allow update: if isAuthenticated() && (
          (request.auth.uid == resource.data.authorId || request.auth.uid == resource.data.userId) &&
          areImmutableFieldsUnchanged(['authorId', 'userId', 'createdAt']) &&
          validStringLength('text', 1, 1000)
        ) || isSuperAdmin();
        allow delete: if isAuthenticated() && (
          request.auth.uid == resource.data.authorId ||
          request.auth.uid == resource.data.userId ||
          request.auth.uid == get(/databases/$(database)/documents/reels/$(reelId)).data.authorId ||
          isSuperAdmin()
        );
      }

      // Reel Likes subcollection
      match /likes/{likeId} {
        allow read: if true;
        allow create: if isAuthenticated() && (
          request.resource.data.userId == request.auth.uid ||
          likeId == request.auth.uid
        );
        allow delete: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          likeId == request.auth.uid ||
          isSuperAdmin()
        );
      }
    }

    // ===============================================================
    // 7. NEXBOT STUDIO CONFIGS (Author-Only Write, Public Read If Published)
    // ===============================================================
    match /nexbot_configs/{configId} {
      // Public read if published; author or SuperAdmin can read drafts/configs
      allow read: if (
        resource.data.isPublished == true ||
        resource.data.published == true ||
        resource.data.status == 'published'
      ) || (
        isAuthenticated() && (
          resource.data.authorId == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          ('uid' in resource.data && resource.data.uid == request.auth.uid) ||
          isSuperAdmin()
        )
      );

      allow create: if isAuthenticated() && isValidNexbotConfig(request.resource.data);

      allow update: if isAuthenticated() && (
        (
          (resource.data.authorId == request.auth.uid || resource.data.userId == request.auth.uid || ('uid' in resource.data && resource.data.uid == request.auth.uid)) &&
          areImmutableFieldsUnchanged(['authorId', 'userId', 'uid', 'createdAt']) &&
          isValidNexbotConfig(request.resource.data)
        ) ||
        isSuperAdmin()
      );

      allow delete: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        ('uid' in resource.data && resource.data.uid == request.auth.uid) ||
        isSuperAdmin()
      );
    }

    // ===============================================================
    // 8. AI SECURITY SCAN LOGS (Create by User, Read by Owner or SuperAdmin)
    // ===============================================================
    match /security_scan_logs/{logId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        ('uid' in resource.data && resource.data.uid == request.auth.uid) ||
        isSuperAdmin()
      );

      // Authenticated users can log their scans; audit logs cannot be updated or deleted by normal users
      allow create: if isAuthenticated() && isValidSecurityScanLog(request.resource.data);
      allow update, delete: if isSuperAdmin();
    }

    // ===============================================================
    // 9. QUARANTINE VAULT (Owner or SuperAdmin Only)
    // ===============================================================
    match /quarantine_vault/{vaultId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        ('uid' in resource.data && resource.data.uid == request.auth.uid) ||
        isSuperAdmin()
      );

      allow create: if isAuthenticated() && isValidQuarantineVault(request.resource.data);

      allow update: if isAuthenticated() && (
        (
          (resource.data.userId == request.auth.uid || resource.data.ownerId == request.auth.uid || ('uid' in resource.data && resource.data.uid == request.auth.uid)) &&
          areImmutableFieldsUnchanged(['userId', 'ownerId', 'uid', 'createdAt']) &&
          isValidQuarantineVault(request.resource.data)
        ) ||
        isSuperAdmin()
      );

      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        ('uid' in resource.data && resource.data.uid == request.auth.uid) ||
        isSuperAdmin()
      );
    }

    // ===============================================================
    // 10. WEBRTC CALL SESSIONS & SIGNALING
    // ===============================================================
    match /call_sessions/{callId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.callerId ||
        request.auth.uid == resource.data.receiverId ||
        ('participants' in resource.data && request.auth.uid in resource.data.participants) ||
        isSuperAdmin()
      );

      allow create: if isAuthenticated() && isValidCallSession(request.resource.data);

      allow update: if isAuthenticated() && (
        (
          (request.auth.uid == resource.data.callerId ||
           request.auth.uid == resource.data.receiverId ||
           ('participants' in resource.data && request.auth.uid in resource.data.participants)) &&
          areImmutableFieldsUnchanged(['callerId', 'createdAt']) &&
          isValidCallSession(request.resource.data)
        ) ||
        isSuperAdmin()
      );

      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.callerId ||
        request.auth.uid == resource.data.receiverId ||
        isSuperAdmin()
      );

      match /iceCandidates/{candidateId} {
        allow read, write: if isAuthenticated() && (
          request.auth.uid == get(/databases/$(database)/documents/call_sessions/$(callId)).data.callerId ||
          request.auth.uid == get(/databases/$(database)/documents/call_sessions/$(callId)).data.receiverId ||
          ('participants' in get(/databases/$(database)/documents/call_sessions/$(callId)).data &&
           request.auth.uid in get(/databases/$(database)/documents/call_sessions/$(callId)).data.participants) ||
          isSuperAdmin()
        );
      }

      match /sdp/{sdpId} {
        allow read, write: if isAuthenticated() && (
          request.auth.uid == get(/databases/$(database)/documents/call_sessions/$(callId)).data.callerId ||
          request.auth.uid == get(/databases/$(database)/documents/call_sessions/$(callId)).data.receiverId ||
          ('participants' in get(/databases/$(database)/documents/call_sessions/$(callId)).data &&
           request.auth.uid in get(/databases/$(database)/documents/call_sessions/$(callId)).data.participants) ||
          isSuperAdmin()
        );
      }

      match /participants/{participantId} {
        allow read, write: if isAuthenticated() && (
          request.auth.uid == get(/databases/$(database)/documents/call_sessions/$(callId)).data.callerId ||
          request.auth.uid == participantId ||
          isSuperAdmin()
        );
      }
    }

    // Backwards-compatible legacy call signaling
    match /calls/{callId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.callerId ||
        request.auth.uid == resource.data.receiverId ||
        isSuperAdmin()
      );

      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.callerId ||
        request.auth.uid == request.resource.data.receiverId
      ) && isValidCallSession(request.resource.data);

      allow update: if isAuthenticated() && (
        (
          (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.receiverId) &&
          areImmutableFieldsUnchanged(['callerId', 'createdAt'])
        ) ||
        isSuperAdmin()
      );

      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.callerId ||
        request.auth.uid == resource.data.receiverId ||
        isSuperAdmin()
      );

      match /iceCandidates/{candidateId} {
        allow read, write: if isAuthenticated() && (
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId ||
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.receiverId ||
          isSuperAdmin()
        );
      }

      match /sdp/{sdpId} {
        allow read, write: if isAuthenticated() && (
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId ||
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.receiverId ||
          isSuperAdmin()
        );
      }
    }

    match /callHistory/{historyId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.callerId ||
        request.auth.uid == resource.data.receiverId ||
        request.auth.uid == resource.data.from ||
        request.auth.uid == resource.data.to ||
        isSuperAdmin()
      );

      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.callerId ||
        request.auth.uid == request.resource.data.receiverId ||
        request.auth.uid == request.resource.data.from ||
        request.auth.uid == request.resource.data.to
      );

      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.callerId ||
        request.auth.uid == resource.data.receiverId ||
        request.auth.uid == resource.data.from ||
        request.auth.uid == resource.data.to ||
        isSuperAdmin()
      );
    }

    match /groupCalls/{groupCallId} {
      allow read: if isAuthenticated() && (
        isGroupMember(resource.data.groupId) ||
        isSuperAdmin()
      );

      allow create: if isAuthenticated() && (
        isGroupMember(request.resource.data.groupId) ||
        isSuperAdmin()
      );

      allow update, delete: if isAuthenticated() && (
        isGroupMember(resource.data.groupId) ||
        isSuperAdmin()
      );

      match /participants/{participantId} {
        allow read, write: if isAuthenticated() && (
          isGroupMember(get(/databases/$(database)/documents/groupCalls/$(groupCallId)).data.groupId) ||
          isSuperAdmin()
        );
      }
    }

    // ===============================================================
    // 11. TOKENS, VIP LICENSES & MONETIZATION
    // ===============================================================
    match /tokens/{tokenId} {
      // Owner or SuperAdmin can read balance
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.ownerId ||
        tokenId == request.auth.uid ||
        isSuperAdmin()
      );

      // Writes restricted strictly to SuperAdmin / backend authority
      allow write: if isSuperAdmin();
    }

    match /vip_licenses/{licenseId} {
      // Owner or SuperAdmin can read license
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.holderId ||
        request.auth.uid == resource.data.ownerId ||
        licenseId == request.auth.uid ||
        isSuperAdmin()
      );

      // Writes restricted strictly to SuperAdmin / backend authority
      allow write: if isSuperAdmin();
    }

    match /tokenGifts/{giftId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.senderId ||
        request.auth.uid == resource.data.recipientId ||
        isSuperAdmin()
      );

      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;

      allow update: if isAuthenticated() && (
        (request.auth.uid == resource.data.recipientId &&
         resource.data.status == 'pending' &&
         request.resource.data.status in ['accepted', 'declined'] &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'acceptedAt', 'declinedAt', 'updatedAt'])) ||
        (request.auth.uid == resource.data.senderId &&
         resource.data.status == 'pending' &&
         request.resource.data.status == 'cancelled' &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'cancelledAt', 'updatedAt'])) ||
        isSuperAdmin()
      );

      allow delete: if isSuperAdmin();
    }

    match /transactions/{txId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        isSuperAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSuperAdmin();
    }

    match /tokenTransactions/{txId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.senderId ||
        request.auth.uid == resource.data.recipientId ||
        isSuperAdmin()
      );
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    match /paymentHistory/{paymentId} {
      allow read: if isOwner(resource.data.userId) || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // ===============================================================
    // 12. DEVICE PAIRING QR SESSIONS
    // ===============================================================
    match /link_sessions/{sessionId} {
      allow read: if true;

      allow create: if request.resource.data.status == 'pending' &&
                       request.resource.data.sessionId == sessionId;

      allow update: if isAuthenticated() && (
        (request.resource.data.status == 'approved' && request.resource.data.primaryUid == request.auth.uid) ||
        (request.resource.data.status in ['rejected', 'expired'] && resource.data.primaryUid == request.auth.uid) ||
        isSuperAdmin()
      );

      allow delete: if (isAuthenticated() && resource.data.primaryUid == request.auth.uid) ||
                       resource.data.expiresAt <= request.time.toMillis() ||
                       isSuperAdmin();
    }

    // ===============================================================
    // 13. ADVERTISEMENTS & MARKETPLACE
    // ===============================================================
    match /advertisements/{adId} {
      allow read: if isAuthenticated() && (
        resource.data.status == 'active' ||
        request.auth.uid == resource.data.sellerUID ||
        isSuperAdmin()
      );

      allow create: if isAuthenticated() &&
                       request.resource.data.sellerUID == request.auth.uid &&
                       validStringLength('title', 1, 140) &&
                       isValidOptionalString('description', 0, 2000);

      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.sellerUID ||
        isSuperAdmin()
      );
    }

    // ===============================================================
    // 14. CHAT REQUESTS & GROUP JOIN REQUESTS
    // ===============================================================
    match /chatRequests/{requestId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.from ||
        request.auth.uid == resource.data.to ||
        isSuperAdmin()
      );

      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.from
      );

      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.from ||
        request.auth.uid == resource.data.to ||
        isSuperAdmin()
      );
    }

    match /groupJoinRequests/{requestId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        isGroupAdmin(resource.data.groupId) ||
        isSuperAdmin()
      );

      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.userId
      );

      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        isGroupAdmin(resource.data.groupId) ||
        isSuperAdmin()
      );
    }

    match /joinRequests/{requestId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        isGroupAdmin(resource.data.groupId) ||
        isSuperAdmin()
      );

      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.userId
      );

      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        isGroupAdmin(resource.data.groupId) ||
        isSuperAdmin()
      );
    }

    match /groupPolls/{pollId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isGroupMember(request.resource.data.groupId);
      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.creatorId ||
        isGroupAdmin(resource.data.groupId) ||
        (isGroupMember(resource.data.groupId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes', 'totalVotes'])) ||
        isSuperAdmin()
      );
    }

    match /pollVotes/{voteId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.userId || isSuperAdmin());
    }

    // ===============================================================
    // 15. GAMING HUB, CLANS, CLIPS & VIDEOS
    // ===============================================================
    match /clans/{clanId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.leaderId == request.auth.uid;
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.leaderId ||
        request.auth.uid in resource.data.members ||
        isSuperAdmin()
      );
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.leaderId ||
        isSuperAdmin()
      );
    }

    match /clanInvites/{inviteId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.invitedUserId ||
        request.auth.uid == resource.data.invitedBy ||
        isSuperAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.invitedBy == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.invitedUserId ||
        request.auth.uid == resource.data.invitedBy ||
        isSuperAdmin()
      );
    }

    match /clips/{clipId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.authorId ||
        isSuperAdmin()
      );
    }

    match /videos/{videoId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.authorId ||
        isSuperAdmin()
      );
    }

    // ===============================================================
    // 16. NEXCHAT-ADMIN DASHBOARD & AUDIT CONTROL SUITE
    // ===============================================================
    match /admins/{adminId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || request.auth.uid == adminId);
      allow write: if isSuperAdmin() &&
                      isValidOptionalString('ipAddress', 0, 45) &&
                      isValidOptionalString('lastIp', 0, 45) &&
                      isValidIpList('ipAddresses', 4) &&
                      isValidIpList('verifiedIps', 4) &&
                      isValidIpList('knownIps', 4);
    }

    match /adminLogs/{logId} {
      allow read, write: if isSuperAdmin() &&
                            isValidOptionalString('ipAddress', 0, 45) &&
                            isValidOptionalString('lastIp', 0, 45) &&
                            isValidIpList('ipAddresses', 4) &&
                            isValidIpList('verifiedIps', 4);
    }

    match /adminAuditLog/{logId} {
      allow read, write: if isSuperAdmin() &&
                            isValidOptionalString('ipAddress', 0, 45) &&
                            isValidOptionalString('lastIp', 0, 45) &&
                            isValidIpList('ipAddresses', 4) &&
                            isValidIpList('verifiedIps', 4);
    }

    match /adminSecurityLogs/{logId} {
      allow read, write: if isSuperAdmin() &&
                            isValidOptionalString('ipAddress', 0, 45) &&
                            isValidOptionalString('lastIp', 0, 45) &&
                            isValidIpList('ipAddresses', 4) &&
                            isValidIpList('verifiedIps', 4);
    }

    match /securityLogs/{logId} {
      allow create: if isAuthenticated() &&
                       isValidOptionalString('ipAddress', 0, 45) &&
                       isValidOptionalString('lastIp', 0, 45) &&
                       isValidIpList('ipAddresses', 4) &&
                       isValidIpList('verifiedIps', 4);
      allow read, write: if isSuperAdmin() &&
                            isValidOptionalString('ipAddress', 0, 45) &&
                            isValidOptionalString('lastIp', 0, 45) &&
                            isValidIpList('ipAddresses', 4) &&
                            isValidIpList('verifiedIps', 4);
    }

    match /securityAuditLogs/{auditId} {
      allow read, write: if isSuperAdmin() &&
                            isValidOptionalString('ipAddress', 0, 45) &&
                            isValidOptionalString('lastIp', 0, 45) &&
                            isValidIpList('ipAddresses', 4) &&
                            isValidIpList('verifiedIps', 4);
    }

    // Admin Dashboard Telemetry & IP Security Verification
    match /admin_telemetry/{docId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated() &&
                       isValidOptionalString('ipAddress', 0, 45) &&
                       isValidOptionalString('lastIp', 0, 45) &&
                       isValidIpList('ipAddresses', 4) &&
                       isValidIpList('verifiedIps', 4);
      allow update, delete: if isSuperAdmin() &&
                               isValidOptionalString('ipAddress', 0, 45) &&
                               isValidOptionalString('lastIp', 0, 45) &&
                               isValidIpList('ipAddresses', 4) &&
                               isValidIpList('verifiedIps', 4);
    }

    match /admin_security/{docId} {
      allow read: if isSuperAdmin();
      allow create, update: if isSuperAdmin() &&
                               isValidOptionalString('ipAddress', 0, 45) &&
                               isValidOptionalString('lastIp', 0, 45) &&
                               isValidIpList('ipAddresses', 4) &&
                               isValidIpList('verifiedIps', 4);
      allow delete: if isSuperAdmin();
    }

    match /admin_ip_verification/{docId} {
      allow read: if isSuperAdmin();
      allow create, update: if isSuperAdmin() &&
                               isValidOptionalString('ipAddress', 0, 45) &&
                               isValidOptionalString('lastIp', 0, 45) &&
                               isValidIpList('ipAddresses', 4) &&
                               isValidIpList('verifiedIps', 4);
      allow delete: if isSuperAdmin();
    }

    match /userActivity/{activityId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isOwner(resource.data.userId) || isSuperAdmin();
      allow update, delete: if isSuperAdmin();
    }

    match /userRegistrations/{regId} {
      allow create: if isAuthenticated();
      allow read, write: if isSuperAdmin();
    }

    match /videoActivity/{vidActId} {
      allow create: if isAuthenticated();
      allow read, write: if isSuperAdmin();
    }

    match /videoEngagement/{engId} {
      allow create: if isAuthenticated();
      allow read, write: if isSuperAdmin();
    }

    match /systemLogs/{logId} {
      allow read, write: if isSuperAdmin();
    }

    match /analytics/{analyticsId} {
      allow read, write: if isSuperAdmin();
    }

    match /tokenStatistics/{statId} {
      allow read, write: if isSuperAdmin();
    }

    match /systemStats/{statId} {
      allow read, write: if isSuperAdmin();
    }

    match /userStats/{uid} {
      allow read: if isOwner(uid) || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    match /groupStats/{groupId} {
      allow read: if isGroupMember(groupId) || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    match /errorLogs/{errorId} {
      allow create: if isAuthenticated();
      allow read, write: if isSuperAdmin();
    }

    match /debugLogs/{debugId} {
      allow create: if isAuthenticated();
      allow read, write: if isSuperAdmin();
    }

    match /performanceMetrics/{metricId} {
      allow create: if isAuthenticated();
      allow read, write: if isSuperAdmin();
    }

    match /apiUsageLogs/{logId} {
      allow create: if isAuthenticated();
      allow read, write: if isSuperAdmin();
    }

    match /backupData/{backupId} {
      allow read, write: if isSuperAdmin();
    }

    match /backupMetadata/{backupId} {
      allow read, write: if isSuperAdmin();
    }

    match /migrationLogs/{migrationId} {
      allow read, write: if isSuperAdmin();
    }

    match /featureUsageStats/{statId} {
      allow read, write: if isSuperAdmin();
    }

    // ===============================================================
    // 17. SYSTEM ANNOUNCEMENTS, REPORTS & MODERATION
    // ===============================================================
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /reports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.reportedBy == request.auth.uid;
      allow read, write: if isSuperAdmin();
    }

    match /blockedUsers/{blockId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        isSuperAdmin()
      );

      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.userId ||
        isSuperAdmin()
      );

      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        isSuperAdmin()
      );
    }

    match /contentModeration/{moderationId} {
      allow read, write: if isSuperAdmin();
    }

    match /spamReports/{reportId} {
      allow create: if isAuthenticated();
      allow read, write: if isSuperAdmin();
    }

    match /contentFilters/{filterId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /userVerification/{verificationId} {
      allow read, write: if isSuperAdmin();
    }

    match /trustScores/{uid} {
      allow read: if isOwner(uid) || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    match /reputation/{reputationId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // ===============================================================
    // 18. USER PREFERENCES, THEMES, SECURITY & CHAT ATMOSPHERE
    // ===============================================================
    match /userBackgrounds/{uid} {
      allow read: if isAuthenticated();
      allow write: if isOwner(uid) || isSuperAdmin();
    }

    match /groupBackgrounds/{groupId} {
      allow read: if isGroupMember(groupId) || isSuperAdmin();
      allow write: if isGroupAdmin(groupId) || isSuperAdmin();
    }

    match /directMessageBackgrounds/{docId} {
      allow read, write: if isAuthenticated() && (
        docId.matches(request.auth.uid + '_.*') ||
        docId.matches('.*_' + request.auth.uid) ||
        isSuperAdmin()
      );
    }

    match /messageActivity/{activityId} {
      allow create: if isAuthenticated() && (
        request.resource.data.senderId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
      allow read: if isAuthenticated() && (
        ('senderId' in resource.data && resource.data.senderId == request.auth.uid) ||
        ('userId' in resource.data && resource.data.userId == request.auth.uid) ||
        isSuperAdmin()
      );
      allow update, delete: if isSuperAdmin();
    }

    // TYPING STATUS: Ephemeral typing indicators with payload bounds
    match /typingStatus/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
                               (request.resource.data.userId == request.auth.uid ||
                                docId.matches(request.auth.uid + '_.*') ||
                                docId.matches('.*_' + request.auth.uid)) &&
                               isValidOptionalString('username', 0, 100);
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        docId.matches(request.auth.uid + '_.*') ||
        docId.matches('.*_' + request.auth.uid) ||
        isSuperAdmin()
      );
    }

    match /userSecurity/{uid} {
      allow read, write: if isOwner(uid) || isSuperAdmin();
    }

    match /status_updates/{statusId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.authorId == request.auth.uid
      ) && isValidOptionalString('content', 0, 2000);
      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.authorId ||
        isSuperAdmin()
      );
    }

    match /offlineMessageQueue/{queueId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isSuperAdmin()
      );

      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        isSuperAdmin()
      );

      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isSuperAdmin()
      );
    }

    match /presence/{uid} {
      allow read: if isAuthenticated();
      allow write: if isOwner(uid) || isSuperAdmin();
    }

    match /appConfig/{configId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /maintenance/{maintenanceId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /featureFlags/{flagId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /rateLimits/{limitId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isSuperAdmin() || (isAuthenticated() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isSuperAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /userSessions/{sessionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isSuperAdmin());
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
    }

    match /deviceTokens/{tokenId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isSuperAdmin());
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
    }

    match /userSettings/{uid} {
      allow read, write: if isOwner(uid) || isSuperAdmin();
    }

    match /userPreferences/{uid} {
      allow read, write: if isOwner(uid) || isSuperAdmin();
    }

    match /themeSettings/{uid} {
      allow read, write: if isOwner(uid) || isSuperAdmin();
    }

    match /notificationSettings/{uid} {
      allow read, write: if isOwner(uid) || isSuperAdmin();
    }

    match /privacySettings/{uid} {
      allow read, write: if isOwner(uid) || isSuperAdmin();
    }

    match /securitySettings/{uid} {
      allow read, write: if isOwner(uid) || isSuperAdmin();
    }

    match /accountSettings/{uid} {
      allow read, write: if isOwner(uid) || isSuperAdmin();
    }

    match /profileSettings/{uid} {
      allow read, write: if isOwner(uid) || isSuperAdmin();
    }

    match /chatSettings/{uid} {
      allow read, write: if isOwner(uid) || isSuperAdmin();
    }

    match /mediaSettings/{uid} {
      allow read, write: if isOwner(uid) || isSuperAdmin();
    }

    match /callSettings/{uid} {
      allow read, write: if isOwner(uid) || isSuperAdmin();
    }

    match /groupSettings/{groupId} {
      allow read: if isGroupMember(groupId) || isSuperAdmin();
      allow write: if isGroupAdmin(groupId) || isSuperAdmin();
    }

    match /marketplaceSettings/{uid} {
      allow read, write: if isOwner(uid) || isSuperAdmin();
    }

    match /userFeedback/{feedbackId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, write: if isSuperAdmin();
    }

    match /supportTickets/{ticketId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isOwner(resource.data.userId) || isSuperAdmin();
      allow update, delete: if isSuperAdmin();
    }

    match /betaFeatures/{featureId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /experimentalFeatures/{featureId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /abTesting/{testId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // ===============================================================
    // 19. GAMIFICATION, BADGES & COMMUNITY CHALLENGES
    // ===============================================================
    match /userBadges/{badgeId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /groupBadges/{badgeId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /userAchievements/{achievementId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /userLevels/{uid} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /userProgress/{progressId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    match /leaderboards/{leaderboardId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /challenges/{challengeId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /userChallenges/{challengeId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    match /groupChallenges/{challengeId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (isGroupMember(request.resource.data.groupId) || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    match /competitions/{competitionId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /tournaments/{tournamentId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /gamification/{gamificationId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /rewards/{rewardId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isOwner(resource.data.userId) || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    match /premiumFeatures/{featureId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // ===============================================================
    // 20. SOCIAL FEATURES, STORIES & LIVE STREAMS
    // ===============================================================
    match /socialFeatures/{featureId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /friendRequests/{requestId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.from ||
        request.auth.uid == resource.data.to ||
        isSuperAdmin()
      );

      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.from
      );

      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.from ||
        request.auth.uid == resource.data.to ||
        isSuperAdmin()
      );
    }

    match /friends/{friendId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.friendId ||
        isSuperAdmin()
      );

      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.userId ||
        request.auth.uid == request.resource.data.friendId
      );

      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.friendId ||
        isSuperAdmin()
      );
    }

    match /followers/{followId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.followerId ||
        isSuperAdmin()
      );
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.followerId ||
        isSuperAdmin()
      );
    }

    match /socialPosts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.authorId ||
        isSuperAdmin()
      );
    }

    match /postLikes/{likeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.userId ||
        isSuperAdmin()
      );
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        isSuperAdmin()
      );
    }

    match /postComments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        isSuperAdmin()
      );
    }

    match /stories/{storyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        isSuperAdmin()
      );
    }

    match /storyViews/{viewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.viewerId == request.auth.uid;
    }

    match /liveStreams/{streamId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.hostId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.hostId ||
        isSuperAdmin()
      );
    }

    match /streamViewers/{viewerId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        viewerId == request.auth.uid ||
        isSuperAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        viewerId == request.auth.uid ||
        isSuperAdmin()
      );
    }

    match /streamChat/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                       request.resource.data.senderId == request.auth.uid &&
                       validStringLength('text', 1, 1000);
      allow delete: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        isSuperAdmin()
      );
    }

    match /videoComments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid &&
                       validStringLength('text', 1, 1000);
      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        isSuperAdmin()
      );
    }

    match /videoLikes/{likeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.userId ||
        isSuperAdmin()
      );
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        isSuperAdmin()
      );
    }

    match /playlists/{playlistId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        isSuperAdmin()
      );
    }

    match /playlistVideos/{videoId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.userId ||
        isSuperAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        isSuperAdmin()
      );
    }

    match /sharedMedia/{mediaId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.senderId ||
        request.auth.uid == resource.data.recipientId ||
        isSuperAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.senderId ||
        isSuperAdmin()
      );
    }

    // ===============================================================
    // 21. ZERO-TRUST DEFAULT DENY BARRIER
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
