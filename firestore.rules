rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // CORE SECURITY & VALIDATION HELPER FUNCTIONS
    // ===============================================================

    // 1. Authenticated User Check
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // 2. Resource Owner Check by User ID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 3. Super Admin Verification
    function isSuperAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email in ['demonalexander526@gmail.com', 'alexhack235@gmail.com', 'alexandergamedeveloper74@gmail.com'] &&
         request.auth.token.email_verified == true) ||
        request.auth.token.admin == true ||
        request.auth.uid in ['demonalexander526', 'alexhack235', 'ZhvqSK7NNtQUP1sqszYfo1kzXSb2'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'])
      );
    }

    // 4. Group Membership Verification
    function isGroupMember(groupId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/groups/$(groupId)) &&
             (
               ('members' in get(/databases/$(database)/documents/groups/$(groupId)).data &&
                request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members) ||
               ('creatorId' in get(/databases/$(database)/documents/groups/$(groupId)).data &&
                request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.creatorId) ||
               ('createdBy' in get(/databases/$(database)/documents/groups/$(groupId)).data &&
                request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy) ||
               isSuperAdmin()
             );
    }

    // 5. Group Admin Verification
    function isGroupAdmin(groupId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/groups/$(groupId)) &&
             (
               ('admins' in get(/databases/$(database)/documents/groups/$(groupId)).data &&
                request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.admins) ||
               ('creatorId' in get(/databases/$(database)/documents/groups/$(groupId)).data &&
                request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.creatorId) ||
               ('createdBy' in get(/databases/$(database)/documents/groups/$(groupId)).data &&
                request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy) ||
               isSuperAdmin()
             );
    }

    // 6. Group Moderator Verification
    function isGroupModerator(groupId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/groups/$(groupId)) &&
             (
               isGroupAdmin(groupId) ||
               (
                 'moderators' in get(/databases/$(database)/documents/groups/$(groupId)).data &&
                 request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.moderators
               )
             );
    }

    // 7. Direct Message Sender / Recipient / Participant Helpers
    function isMessageSender(data) {
      return ('from' in data && request.auth.uid == data.from) ||
             ('senderId' in data && request.auth.uid == data.senderId);
    }

    function isMessageRecipient(data) {
      return ('to' in data && request.auth.uid == data.to) ||
             ('receiverId' in data && request.auth.uid == data.receiverId);
    }

    function isMessageParticipant(data) {
      return isMessageSender(data) || isMessageRecipient(data);
    }

    function isChatParticipant(chatId) {
      return isAuthenticated() && (
        chatId.matches(request.auth.uid + '_.*') ||
        chatId.matches('.*_' + request.auth.uid) ||
        chatId == request.auth.uid ||
        (exists(/databases/$(database)/documents/chats/$(chatId)) && (
          ('participants' in get(/databases/$(database)/documents/chats/$(chatId)).data &&
           request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants) ||
          ('members' in get(/databases/$(database)/documents/chats/$(chatId)).data &&
           request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members) ||
          ('creatorId' in get(/databases/$(database)/documents/chats/$(chatId)).data &&
           request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.creatorId)
        ))
      );
    }

    // 8. String & List Bounds Validators
    function validStringLength(field, minLen, maxLen) {
      return field in request.resource.data &&
             request.resource.data[field] is string &&
             request.resource.data[field].size() >= minLen &&
             request.resource.data[field].size() <= maxLen;
    }

    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
             request.resource.data[field] == null ||
             (request.resource.data[field] is string &&
              request.resource.data[field].size() >= minLen &&
              request.resource.data[field].size() <= maxLen);
    }

    function isValidUrl(url) {
      return url is string &&
             (
               (url.size() <= 2048 && (
                 url.matches("^https?://.*") ||
                 url.matches("^/.*") ||
                 url.matches("^[a-zA-Z0-9_.-]+$") ||
                 url.matches("^[a-zA-Z0-9_./-]+$") ||
                 url == ""
               )) ||
               (url.size() <= 1048576 && (url.matches("^data:image/.*") || url.matches("^data:video/.*") || url.matches("^data:audio/.*") || url.matches("^blob:.*")))
             );
    }

    function isValidOptionalUrl(field) {
      return !(field in request.resource.data) ||
             request.resource.data[field] == null ||
             isValidUrl(request.resource.data[field]);
    }

    function isValidList(val, maxSize) {
      return val is list && val.size() <= maxSize;
    }

    function isValidOptionalList(field, maxSize) {
      return !(field in request.resource.data) ||
             request.resource.data[field] == null ||
             isValidList(request.resource.data[field], maxSize);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ===============================================================
    // DOMAIN VALIDATOR FUNCTIONS
    // ===============================================================

    function isValidUserCreate(data) {
      return (!('role' in data) || data.role in ['user', 'member', 'creator']) &&
             (!('isAdmin' in data) || data.isAdmin == false) &&
             (!('isSuperAdmin' in data) || data.isSuperAdmin == false) &&
             isValidOptionalString('username', 1, 100) &&
             isValidOptionalString('displayName', 0, 100) &&
             isValidOptionalString('email', 0, 255) &&
             isValidOptionalUrl('photoURL') &&
             isValidOptionalUrl('avatar') &&
             isValidOptionalString('bio', 0, 1000) &&
             isValidOptionalList('contacts', 5000);
    }

    function isValidUserUpdate(data, prev) {
      return areImmutableFieldsUnchanged(['uid', 'createdAt']) &&
             (!data.diff(prev).affectedKeys().hasAny(['role', 'isAdmin', 'isSuperAdmin', 'banned'])) &&
             isValidOptionalString('username', 1, 100) &&
             isValidOptionalString('displayName', 0, 100) &&
             isValidOptionalString('email', 0, 255) &&
             isValidOptionalUrl('photoURL') &&
             isValidOptionalUrl('avatar') &&
             isValidOptionalString('bio', 0, 1000) &&
             isValidOptionalList('contacts', 5000) &&
             isValidOptionalList('approvedChatUsers', 1000);
    }

    function isValidMessageCreate(data) {
      return isMessageSender(data) &&
             isValidOptionalString('text', 0, 10000) &&
             isValidOptionalString('content', 0, 10000) &&
             isValidOptionalString('message', 0, 10000) &&
             isValidOptionalString('type', 0, 50) &&
             isValidOptionalString('status', 0, 50) &&
             isValidOptionalList('deletedFor', 500);
    }

    function isValidMessageUpdate(data, prev) {
      return (
        // Sender editing text, reactions, or updating deletedFor
        (
          isMessageSender(prev) &&
          areImmutableFieldsUnchanged(['from', 'senderId', 'to', 'receiverId', 'createdAt', 'timestamp']) &&
          isValidOptionalString('text', 0, 10000) &&
          isValidOptionalString('content', 0, 10000) &&
          isValidOptionalList('deletedFor', 500)
        ) ||
        // Recipient updating status (read, delivered), reactions, or deletedFor
        (
          isMessageRecipient(prev) &&
          areImmutableFieldsUnchanged(['from', 'senderId', 'to', 'receiverId', 'createdAt', 'timestamp', 'text', 'content', 'message']) &&
          data.diff(prev).affectedKeys().hasOnly(['status', 'read', 'readAt', 'delivered', 'deliveredAt', 'reactions', 'deletedFor']) &&
          isValidOptionalList('deletedFor', 500)
        ) ||
        // Either participant tombstoning (isDeleted, deletedForEveryone)
        (
          isMessageParticipant(prev) &&
          areImmutableFieldsUnchanged(['from', 'senderId', 'to', 'receiverId', 'createdAt', 'timestamp']) &&
          data.diff(prev).affectedKeys().hasOnly(['isDeleted', 'deletedForEveryone', 'deletedAt', 'deletedFor', 'attachment']) &&
          isValidOptionalList('deletedFor', 500)
        ) ||
        isSuperAdmin()
      );
    }

    function isValidGroupCreate(data) {
      return (
        ('creatorId' in data && data.creatorId == request.auth.uid) ||
        ('createdBy' in data && data.createdBy == request.auth.uid) ||
        isSuperAdmin()
      ) &&
      validStringLength('name', 1, 128) &&
      isValidOptionalString('description', 0, 1000) &&
      isValidOptionalList('members', 100) &&
      isValidOptionalList('admins', 100);
    }

    function isValidGroupAdminUpdate() {
      return isValidOptionalString('name', 1, 128) &&
             isValidOptionalString('description', 0, 1000) &&
             isValidOptionalString('privacy', 0, 50) &&
             isValidOptionalString('approval', 0, 50) &&
             isValidOptionalString('inviteCode', 0, 64) &&
             isValidOptionalUrl('profilePic') &&
             isValidOptionalUrl('groupPic') &&
             isValidOptionalUrl('icon') &&
             isValidOptionalList('members', 100) &&
             isValidOptionalList('admins', 100) &&
             isValidOptionalList('moderators', 100);
    }

    function isValidGroupMessage(data) {
      return (
        ('senderId' in data && data.senderId == request.auth.uid) ||
        ('from' in data && data.from == request.auth.uid) ||
        ('from' in data && data.from == 'group_defense_bot') ||
        isSuperAdmin()
      ) &&
      isValidOptionalString('text', 0, 10000) &&
      isValidOptionalString('content', 0, 10000) &&
      isValidOptionalString('senderName', 0, 100) &&
      isValidOptionalUrl('senderAvatar') &&
      isValidOptionalList('deletedFor', 500);
    }

    function isValidGroupMessageUpdate(data, prev, groupId) {
      return (
        // Sender editing text or reactions
        (
          (('senderId' in prev && prev.senderId == request.auth.uid) || ('from' in prev && prev.from == request.auth.uid)) &&
          areImmutableFieldsUnchanged(['senderId', 'from', 'groupId', 'createdAt', 'timestamp']) &&
          isValidOptionalString('text', 0, 10000) &&
          isValidOptionalString('content', 0, 10000) &&
          isValidOptionalList('deletedFor', 500)
        ) ||
        // Sender or moderator tombstoning message
        (
          (('senderId' in prev && prev.senderId == request.auth.uid) || ('from' in prev && prev.from == request.auth.uid) || isGroupModerator(groupId)) &&
          areImmutableFieldsUnchanged(['senderId', 'from', 'groupId', 'createdAt', 'timestamp']) &&
          data.diff(prev).affectedKeys().hasOnly(['isDeleted', 'deletedForEveryone', 'deletedAt', 'deletedFor', 'attachment', 'text', 'content', 'message']) &&
          isValidOptionalList('deletedFor', 500)
        ) ||
        // Group members updating reactions, readBy, readAt, deletedFor
        (
          isGroupMember(groupId) &&
          areImmutableFieldsUnchanged(['senderId', 'from', 'groupId', 'createdAt', 'timestamp']) &&
          data.diff(prev).affectedKeys().hasOnly(['reactions', 'readBy', 'readAt', 'deletedFor', 'status', 'read']) &&
          isValidOptionalList('deletedFor', 500)
        ) ||
        isGroupModerator(groupId) ||
        isSuperAdmin()
      );
    }

    function isValidStatusStoryCreate(data) {
      return (
        ('userId' in data && data.userId == request.auth.uid) ||
        ('authorId' in data && data.authorId == request.auth.uid) ||
        isSuperAdmin()
      ) &&
      isValidOptionalString('content', 0, 5000) &&
      isValidOptionalString('caption', 0, 5000) &&
      isValidOptionalString('text', 0, 5000) &&
      isValidOptionalUrl('imageUrl') &&
      isValidOptionalUrl('mediaUrl') &&
      isValidOptionalUrl('videoUrl');
    }

    function isValidReel(data) {
      return (
        ('authorId' in data && data.authorId == request.auth.uid) ||
        ('userId' in data && data.userId == request.auth.uid) ||
        isSuperAdmin()
      ) &&
      isValidOptionalString('caption', 0, 2000) &&
      isValidOptionalUrl('videoUrl') &&
      isValidOptionalUrl('thumbnailUrl');
    }

    function isValidGlobalDropCreate() {
      return isValidOptionalString('content', 0, 5000) &&
             isValidOptionalUrl('videoUrl') &&
             isValidOptionalUrl('thumbnailUrl') &&
             isValidOptionalList('mediaUrls', 20) &&
             isValidOptionalList('tags', 50);
    }

    function isValidChannelCreate(data) {
      return ('creatorId' in data && data.creatorId == request.auth.uid) &&
             validStringLength('name', 1, 100) &&
             isValidOptionalString('handle', 0, 100) &&
             isValidOptionalString('description', 0, 2000) &&
             (!('isVerified' in data) || data.isVerified == false || isSuperAdmin());
    }

    function isValidChannelUpdate() {
      return validStringLength('name', 1, 100) &&
             isValidOptionalString('handle', 0, 100) &&
             isValidOptionalString('description', 0, 2000) &&
             isValidOptionalUrl('avatar') &&
             isValidOptionalUrl('profilePic') &&
             isValidOptionalUrl('icon');
    }

    function isValidPostCreate(data, channelId) {
      return (
        ('authorId' in data && data.authorId == request.auth.uid) ||
        (channelId != '' && exists(/databases/$(database)/documents/channels/$(channelId)) &&
         get(/databases/$(database)/documents/channels/$(channelId)).data.creatorId == request.auth.uid) ||
        isSuperAdmin()
      ) &&
      isValidOptionalString('text', 0, 10000) &&
      isValidOptionalString('content', 0, 10000) &&
      isValidOptionalUrl('image') &&
      isValidOptionalUrl('mediaUrl');
    }

    function isValidAdvertisement(data) {
      return validStringLength('title', 1, 150) &&
             isValidOptionalString('description', 0, 2000) &&
             isValidOptionalUrl('imageUrl') &&
             isValidOptionalUrl('linkUrl') &&
             (!('price' in data) || (data.price is number && data.price >= 0));
    }

    function isValidCreatorBadge() {
      return isValidOptionalString('name', 1, 100) &&
             isValidOptionalString('title', 1, 100) &&
             isValidOptionalString('description', 0, 500) &&
             isValidOptionalUrl('icon') &&
             isValidOptionalUrl('imageUrl');
    }

    function isValidNearbyRadar(data, uid) {
      return ('uid' in data && data.uid == uid) &&
             (!('geohash' in data) || (data.geohash is string && data.geohash.size() <= 20)) &&
             (!('latitude' in data) || (data.latitude is number && data.latitude >= -90.0 && data.latitude <= 90.0)) &&
             (!('longitude' in data) || (data.longitude is number && data.longitude >= -180.0 && data.longitude <= 180.0));
    }

    function isValidReport(data) {
      return ('reportedBy' in data && data.reportedBy == request.auth.uid) &&
             validStringLength('reason', 1, 500) &&
             isValidOptionalString('targetId', 0, 128) &&
             isValidOptionalString('targetType', 0, 50);
    }

    function isValidLinkSessionCreate(data, sessionId) {
      return (sessionId.size() <= 128) &&
             validStringLength('pairingCode', 1, 20) &&
             (!('deviceInfo' in data) || data.deviceInfo is map) &&
             (!('ipAddress' in data) || (data.ipAddress is string && data.ipAddress.size() <= 45));
    }

    function isValidUserSubDoc(data, uid) {
      return (!('userId' in data) || data.userId == uid) &&
             (!('uid' in data) || data.uid == uid);
    }

    // ===============================================================
    // 1. USERS COLLECTION & SUBCOLLECTIONS
    // ===============================================================
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if isOwner(uid) && isValidUserCreate(request.resource.data);
      allow update: if (isOwner(uid) && isValidUserUpdate(request.resource.data, resource.data)) ||
                       (
                         isAuthenticated() &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvedChatUsers']) &&
                         isValidOptionalList('approvedChatUsers', 1000)
                       ) ||
                       isSuperAdmin();
      allow delete: if isSuperAdmin();

      // Private User Subcollections (preferences, settings, linkedDevices, devices, authorized_extensions, bookmarks, notifications, contacts, sessions)
      match /preferences/{prefId} {
        allow read, write: if isOwner(uid) || isSuperAdmin();
      }

      match /settings/{settingId} {
        allow read, write: if isOwner(uid) || isSuperAdmin();
      }

      match /linkedDevices/{deviceId} {
        allow read, write: if isOwner(uid) || isSuperAdmin();
      }

      match /devices/{deviceId} {
        allow read, write: if isOwner(uid) || isSuperAdmin();
      }

      match /authorized_extensions/{extensionId} {
        allow read, write: if isOwner(uid) || isSuperAdmin();
      }

      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(uid) || isSuperAdmin();
      }

      match /notifications/{notifId} {
        allow read: if isOwner(uid) || isSuperAdmin();
        allow create: if (
          isOwner(uid) ||
          (
            isAuthenticated() &&
            (
              ('from' in request.resource.data && request.resource.data.from == request.auth.uid) ||
              ('senderId' in request.resource.data && request.resource.data.senderId == request.auth.uid) ||
              ('authorId' in request.resource.data && request.resource.data.authorId == request.auth.uid)
            )
          ) ||
          isSuperAdmin()
        );
        allow update, delete: if isOwner(uid) || isSuperAdmin();
      }

      match /contacts/{contactId} {
        allow read, write: if isOwner(uid) || isSuperAdmin();
      }

      match /sessions/{sessionId} {
        allow read, write: if isOwner(uid) || isSuperAdmin();
      }

      match /{subcollection}/{docId} {
        allow read: if isOwner(uid) || isSuperAdmin();
        allow create, update: if (isOwner(uid) || isSuperAdmin()) && isValidUserSubDoc(request.resource.data, uid);
        allow delete: if isOwner(uid) || isSuperAdmin();
      }
    }

    // ===============================================================
    // 2. DIRECT MESSAGES
    // ===============================================================
    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
        resource.data.to == request.auth.uid ||
        resource.data.from == request.auth.uid ||
        ('receiverId' in resource.data && resource.data.receiverId == request.auth.uid) ||
        ('senderId' in resource.data && resource.data.senderId == request.auth.uid) ||
        isSuperAdmin()
      );
      allow create: if isAuthenticated() && isValidMessageCreate(request.resource.data);
      allow update: if isAuthenticated() && isValidMessageUpdate(request.resource.data, resource.data);
      allow delete: if isAuthenticated() && (isMessageSender(resource.data) || isSuperAdmin());
    }

    // Direct Chats & Chat Threads (Compatibility & Subcollections)
    match /chats/{chatId} {
      allow read: if isAuthenticated() && (isChatParticipant(chatId) || resource == null || isSuperAdmin());
      allow create: if isAuthenticated() && (
        isChatParticipant(chatId) ||
        (request.resource.data.participants is list && request.auth.uid in request.resource.data.participants && isValidList(request.resource.data.participants, 100)) ||
        (request.resource.data.members is list && request.auth.uid in request.resource.data.members && isValidList(request.resource.data.members, 100)) ||
        request.resource.data.creatorId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        isSuperAdmin()
      );
      allow update: if isAuthenticated() && (isChatParticipant(chatId) || isSuperAdmin());
      allow delete: if isAuthenticated() && (resource.data.creatorId == request.auth.uid || resource.data.userId == request.auth.uid || isSuperAdmin());

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (isChatParticipant(chatId) || isMessageParticipant(resource.data) || isSuperAdmin());
        allow create: if isAuthenticated() && isChatParticipant(chatId) && isValidMessageCreate(request.resource.data);
        allow update: if isAuthenticated() && isChatParticipant(chatId) && isValidMessageUpdate(request.resource.data, resource.data);
        allow delete: if isAuthenticated() && ((isChatParticipant(chatId) && isMessageSender(resource.data)) || isSuperAdmin());
      }

      match /typing/{userId} {
        allow read: if isAuthenticated() && (isChatParticipant(chatId) || isSuperAdmin());
        allow write: if isAuthenticated() && ((isChatParticipant(chatId) && (userId == request.auth.uid || isOwner(userId))) || isSuperAdmin());
      }

      match /participants/{participantId} {
        allow read: if isAuthenticated() && (isChatParticipant(chatId) || isSuperAdmin());
        allow write: if isAuthenticated() && ((isChatParticipant(chatId) && (participantId == request.auth.uid || isOwner(participantId))) || isSuperAdmin());
      }
    }

    match /chatThreads/{threadId} {
      allow read, write: if isAuthenticated();

      match /replies/{replyId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && (request.resource.data.senderId == request.auth.uid || request.resource.data.authorId == request.auth.uid || isSuperAdmin());
        allow update, delete: if isAuthenticated() && (resource.data.senderId == request.auth.uid || resource.data.authorId == request.auth.uid || isSuperAdmin());
      }
    }

    // ===============================================================
    // 3. GROUPS & GROUP MESSAGES
    // ===============================================================
    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidGroupCreate(request.resource.data);
      allow update: if isAuthenticated() && (
        (
          isGroupAdmin(groupId) &&
          areImmutableFieldsUnchanged(['creatorId', 'createdBy', 'createdAt']) &&
          isValidGroupAdminUpdate()
        ) ||
        (
          isGroupModerator(groupId) &&
          areImmutableFieldsUnchanged(['creatorId', 'createdBy', 'createdAt', 'name', 'privacy', 'approval', 'admins']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinnedMessages', 'mutedMembers', 'settings', 'updatedAt'])
        ) ||
        (
          isGroupMember(groupId) &&
          areImmutableFieldsUnchanged(['creatorId', 'createdBy', 'createdAt', 'name', 'privacy', 'approval']) &&
          !(request.auth.uid in request.resource.data.members) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'admins', 'moderators', 'roles', 'updatedAt']) &&
          isValidOptionalList('members', 100)
        ) ||
        (
          (!('approval' in resource.data) || resource.data.approval != 'admin') &&
          (!('privacy' in resource.data) || resource.data.privacy != 'private') &&
          !(request.auth.uid in resource.data.members) &&
          request.auth.uid in request.resource.data.members &&
          (!('admins' in request.resource.data) || !(request.auth.uid in request.resource.data.admins)) &&
          areImmutableFieldsUnchanged(['creatorId', 'createdBy', 'createdAt', 'name', 'description', 'privacy', 'approval', 'admins', 'moderators', 'inviteCode', 'settings']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'roles', 'updatedAt']) &&
          isValidList(request.resource.data.members, 100)
        ) ||
        (
          isGroupMember(groupId) &&
          areImmutableFieldsUnchanged(['creatorId', 'createdBy', 'createdAt', 'members', 'admins', 'moderators', 'roles', 'name', 'privacy', 'approval', 'inviteCode', 'settings']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageTime', 'lastSender', 'updatedAt']) &&
          isValidOptionalString('lastMessage', 0, 10000) &&
          isValidOptionalString('lastSender', 0, 128)
        ) ||
        isSuperAdmin()
      );
      allow delete: if isAuthenticated() && (
        ('creatorId' in resource.data && request.auth.uid == resource.data.creatorId) ||
        ('createdBy' in resource.data && request.auth.uid == resource.data.createdBy) ||
        isSuperAdmin()
      );

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (isGroupMember(groupId) || isSuperAdmin());
        allow create: if isAuthenticated() && isGroupMember(groupId) && isValidGroupMessage(request.resource.data);
        allow update: if isAuthenticated() && isGroupMember(groupId) && isValidGroupMessageUpdate(request.resource.data, resource.data, groupId);
        allow delete: if isAuthenticated() && (
          ('senderId' in resource.data && request.auth.uid == resource.data.senderId) ||
          ('from' in resource.data && request.auth.uid == resource.data.from) ||
          isGroupAdmin(groupId) ||
          isSuperAdmin()
        );
      }

      match /documents/{documentId} {
        allow read: if isAuthenticated() && (isGroupMember(groupId) || isSuperAdmin());
        allow create: if isAuthenticated() && isGroupMember(groupId) && request.resource.data.uploadedBy == request.auth.uid;
        allow update, delete: if isAuthenticated() && (request.auth.uid == resource.data.uploadedBy || isGroupAdmin(groupId) || isSuperAdmin());
      }

      match /sharedMedia/{mediaId} {
        allow read: if isAuthenticated() && (isGroupMember(groupId) || isSuperAdmin());
        allow create: if isAuthenticated() && isGroupMember(groupId) && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isAuthenticated() && (request.auth.uid == resource.data.senderId || isGroupAdmin(groupId) || isSuperAdmin());
      }
    }

    match /groupMessages/{messageId} {
      allow read: if isAuthenticated() && (isGroupMember(resource.data.groupId) || isSuperAdmin());
      allow create: if isAuthenticated() &&
                       request.resource.data.groupId is string &&
                       isGroupMember(request.resource.data.groupId) &&
                       isValidGroupMessage(request.resource.data);
      allow update: if isAuthenticated() &&
                       isGroupMember(resource.data.groupId) &&
                       isValidGroupMessageUpdate(request.resource.data, resource.data, resource.data.groupId);
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.from ||
        request.auth.uid == resource.data.senderId ||
        isGroupModerator(resource.data.groupId) ||
        isSuperAdmin()
      );
    }

    // ===============================================================
    // 4. REQUESTS & POLLS
    // ===============================================================
    match /chatRequests/{requestId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.from ||
        request.auth.uid == resource.data.to ||
        isSuperAdmin()
      );
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.from;
      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.from ||
        request.auth.uid == resource.data.to ||
        isSuperAdmin()
      );
    }

    match /groupJoinRequests/{requestId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        isGroupAdmin(resource.data.groupId) ||
        isSuperAdmin()
      );
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        isGroupAdmin(resource.data.groupId) ||
        isSuperAdmin()
      );
    }

    match /joinRequests/{requestId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        isGroupAdmin(resource.data.groupId) ||
        isSuperAdmin()
      );
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        isGroupAdmin(resource.data.groupId) ||
        isSuperAdmin()
      );
    }

    match /groupPolls/{pollId} {
      allow read: if isAuthenticated() && (isGroupMember(resource.data.groupId) || isSuperAdmin());
      allow create: if isAuthenticated() && isGroupMember(request.resource.data.groupId);
      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.creatorId ||
        isGroupAdmin(resource.data.groupId) ||
        (isGroupMember(resource.data.groupId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes', 'totalVotes'])) ||
        isSuperAdmin()
      );

      match /pollVotes/{voteId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow delete: if isAuthenticated() && (request.auth.uid == resource.data.userId || isSuperAdmin());
      }
    }

    // ===============================================================
    // 5. STATUSES & STORIES
    // ===============================================================
    match /statuses/{statusId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidStatusStoryCreate(request.resource.data);
      allow update: if isAuthenticated() && (
        (
          (('userId' in resource.data && isOwner(resource.data.userId)) ||
           ('authorId' in resource.data && isOwner(resource.data.authorId)) ||
           isSuperAdmin()) &&
          areImmutableFieldsUnchanged(['userId', 'authorId', 'createdAt'])
        ) ||
        (
          areImmutableFieldsUnchanged(['userId', 'authorId', 'createdAt', 'content', 'caption', 'text', 'imageUrl', 'mediaUrl', 'videoUrl', 'audioUrl', 'voiceUrl']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'viewCount', 'viewsCount', 'pollData', 'poll', 'likedBy', 'likes', 'likesCount']) &&
          isValidOptionalList('views', 10000) &&
          isValidOptionalList('likedBy', 10000) &&
          isValidOptionalList('likes', 10000)
        )
      );
      allow delete: if isAuthenticated() && (
        ('userId' in resource.data && isOwner(resource.data.userId)) ||
        ('authorId' in resource.data && isOwner(resource.data.authorId)) ||
        isSuperAdmin()
      );

      match /views/{viewId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && (
          request.resource.data.uid == request.auth.uid ||
          request.resource.data.viewerId == request.auth.uid ||
          request.resource.data.userId == request.auth.uid ||
          viewId == request.auth.uid
        );
        allow delete: if isAuthenticated() && (
          resource.data.uid == request.auth.uid ||
          resource.data.viewerId == request.auth.uid ||
          viewId == request.auth.uid ||
          isSuperAdmin()
        );
      }

      match /reactions/{reactionId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || reactionId == request.auth.uid);
        allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || reactionId == request.auth.uid || isSuperAdmin());
      }
    }

    match /status/{statusId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidStatusStoryCreate(request.resource.data);
      allow update: if isAuthenticated() && (
        (
          (('userId' in resource.data && isOwner(resource.data.userId)) ||
           ('authorId' in resource.data && isOwner(resource.data.authorId)) ||
           isSuperAdmin()) &&
          areImmutableFieldsUnchanged(['userId', 'authorId', 'createdAt'])
        ) ||
        (
          areImmutableFieldsUnchanged(['userId', 'authorId', 'createdAt', 'content', 'caption', 'text', 'imageUrl', 'mediaUrl', 'videoUrl', 'audioUrl', 'voiceUrl']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'viewCount', 'viewsCount', 'pollData', 'poll', 'likedBy', 'likes', 'likesCount']) &&
          isValidOptionalList('views', 10000) &&
          isValidOptionalList('likedBy', 10000) &&
          isValidOptionalList('likes', 10000)
        )
      );
      allow delete: if isAuthenticated() && (
        ('userId' in resource.data && isOwner(resource.data.userId)) ||
        ('authorId' in resource.data && isOwner(resource.data.authorId)) ||
        isSuperAdmin()
      );

      match /views/{viewId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || viewId == request.auth.uid);
        allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || viewId == request.auth.uid || isSuperAdmin());
      }

      match /reactions/{reactionId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || reactionId == request.auth.uid);
        allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || reactionId == request.auth.uid || isSuperAdmin());
      }
    }

    match /status_updates/{statusId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidStatusStoryCreate(request.resource.data);
      allow update: if isAuthenticated() && (
        (
          (('userId' in resource.data && isOwner(resource.data.userId)) ||
           ('authorId' in resource.data && isOwner(resource.data.authorId)) ||
           isSuperAdmin()) &&
          areImmutableFieldsUnchanged(['userId', 'authorId', 'createdAt'])
        ) ||
        (
          areImmutableFieldsUnchanged(['userId', 'authorId', 'createdAt', 'content', 'caption', 'text', 'imageUrl', 'mediaUrl', 'videoUrl', 'audioUrl', 'voiceUrl']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'viewCount', 'viewsCount', 'pollData', 'poll', 'likedBy', 'likes', 'likesCount']) &&
          isValidOptionalList('views', 10000) &&
          isValidOptionalList('likedBy', 10000) &&
          isValidOptionalList('likes', 10000)
        )
      );
      allow delete: if isAuthenticated() && (
        ('userId' in resource.data && isOwner(resource.data.userId)) ||
        ('authorId' in resource.data && isOwner(resource.data.authorId)) ||
        isSuperAdmin()
      );

      match /views/{viewId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || viewId == request.auth.uid);
        allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || viewId == request.auth.uid || isSuperAdmin());
      }

      match /reactions/{reactionId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || reactionId == request.auth.uid);
        allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || reactionId == request.auth.uid || isSuperAdmin());
      }
    }

    // ===============================================================
    // 6. REELS
    // ===============================================================
    match /reels/{reelId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidReel(request.resource.data);
      allow update: if isAuthenticated() && (
        (
          (request.auth.uid == resource.data.authorId || request.auth.uid == resource.data.userId) &&
          areImmutableFieldsUnchanged(['authorId', 'userId', 'createdAt']) &&
          isValidReel(request.resource.data)
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) &&
          request.resource.data.views is number &&
          (!('views' in resource.data) || request.resource.data.views >= resource.data.views)
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'likes', 'likesCount', 'commentsCount', 'views', 'sharesCount',
            'poll', 'tokensTipped', 'c2paManifest', 'syntheticMetrics', 'provenanceStatus'
          ]) &&
          isValidOptionalList('likes', 10000) &&
          isValidOptionalString('provenanceStatus', 0, 100) &&
          (!('views' in request.resource.data) || (request.resource.data.views is number && request.resource.data.views >= 0))
        ) ||
        isSuperAdmin()
      );
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.authorId ||
        request.auth.uid == resource.data.userId ||
        isSuperAdmin()
      );

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() &&
                         (request.resource.data.authorId == request.auth.uid || request.resource.data.userId == request.auth.uid) &&
                         validStringLength('text', 1, 1000) &&
                         isValidOptionalString('authorName', 0, 100) &&
                         isValidOptionalUrl('authorPic');
        allow update: if isAuthenticated() && (
          (
            (request.auth.uid == resource.data.authorId || request.auth.uid == resource.data.userId) &&
            areImmutableFieldsUnchanged(['authorId', 'userId', 'createdAt']) &&
            validStringLength('text', 1, 1000)
          ) ||
          (
            areImmutableFieldsUnchanged(['authorId', 'userId', 'createdAt', 'text']) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likesCount', 'likedBy']) &&
            isValidOptionalList('likedBy', 10000)
          ) ||
          isSuperAdmin()
        );
        allow delete: if isAuthenticated() && (
          request.auth.uid == resource.data.authorId ||
          request.auth.uid == resource.data.userId ||
          isSuperAdmin()
        );
      }

      match /likes/{likeId} {
        allow read: if true;
        allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || likeId == request.auth.uid);
        allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || likeId == request.auth.uid || isSuperAdmin());
      }
    }

    // ===============================================================
    // 7. GLOBAL DROPS
    // ===============================================================
    match /global_drops/{dropId} {
      allow read: if true;
      allow create: if (
        (isAuthenticated() && (
          ('authorId' in request.resource.data && request.resource.data.authorId == request.auth.uid) ||
          ('userId' in request.resource.data && request.resource.data.userId == request.auth.uid)
        )) ||
        (!isAuthenticated() && (
          ('authorId' in request.resource.data && request.resource.data.authorId is string && request.resource.data.authorId.size() > 0 && request.resource.data.authorId.size() <= 128) ||
          ('userId' in request.resource.data && request.resource.data.userId is string && request.resource.data.userId.size() > 0 && request.resource.data.userId.size() <= 128)
        )) ||
        isSuperAdmin()
      ) && isValidGlobalDropCreate();

      allow update: if (
        (
          isAuthenticated() &&
          (('authorId' in resource.data && isOwner(resource.data.authorId)) ||
           ('userId' in resource.data && isOwner(resource.data.userId))) &&
          areImmutableFieldsUnchanged(['authorId', 'userId', 'createdAt']) &&
          isValidOptionalString('content', 0, 5000)
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'likes', 'likesCount', 'signals', 'signalsCount', 'echoes',
            'echoesCount', 'repostsCount', 'repliesCount', 'viewsCount', 'poll'
          ]) &&
          isValidOptionalList('likes', 10000) &&
          isValidOptionalList('echoes', 10000) &&
          isValidOptionalList('signals', 10000)
        ) ||
        isSuperAdmin()
      );

      allow delete: if (
        (isAuthenticated() && (
          ('authorId' in resource.data && isOwner(resource.data.authorId)) ||
          ('userId' in resource.data && isOwner(resource.data.userId))
        )) ||
        (!isAuthenticated() && (
          ('authorId' in resource.data && resource.data.authorId is string && resource.data.authorId.matches('^guest_.*')) ||
          ('userId' in resource.data && resource.data.userId is string && resource.data.userId.matches('^guest_.*'))
        )) ||
        isSuperAdmin() ||
        (resource.data.expiresAtMs is int && resource.data.expiresAtMs <= request.time.toMillis())
      );

      match /comments/{commentId} {
        allow read: if true;
        allow create: if (
          (isAuthenticated() && (
            ('authorId' in request.resource.data && request.resource.data.authorId == request.auth.uid) ||
            ('userId' in request.resource.data && request.resource.data.userId == request.auth.uid)
          )) ||
          (!isAuthenticated() && (
            ('authorId' in request.resource.data && request.resource.data.authorId is string && request.resource.data.authorId.size() > 0 && request.resource.data.authorId.size() <= 128) ||
            ('userId' in request.resource.data && request.resource.data.userId is string && request.resource.data.userId.size() > 0 && request.resource.data.userId.size() <= 128)
          )) ||
          isSuperAdmin()
        ) && (isValidOptionalString('text', 0, 2000) || isValidOptionalString('content', 0, 2000));

        allow update: if (
          (
            isAuthenticated() &&
            (('authorId' in resource.data && isOwner(resource.data.authorId)) ||
             ('userId' in resource.data && isOwner(resource.data.userId))) &&
            areImmutableFieldsUnchanged(['authorId', 'userId', 'createdAt']) &&
            (isValidOptionalString('text', 0, 2000) || isValidOptionalString('content', 0, 2000))
          ) ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likesCount', 'signals', 'signalsCount']) &&
            isValidOptionalList('likes', 1000) &&
            isValidOptionalList('signals', 1000)
          ) ||
          isSuperAdmin()
        );

        allow delete: if (
          (isAuthenticated() && (
            ('authorId' in resource.data && isOwner(resource.data.authorId)) ||
            ('userId' in resource.data && isOwner(resource.data.userId))
          )) ||
          (!isAuthenticated() && (
            ('authorId' in resource.data && resource.data.authorId is string && resource.data.authorId.matches('^guest_.*')) ||
            ('userId' in resource.data && resource.data.userId is string && resource.data.userId.matches('^guest_.*'))
          )) ||
          isSuperAdmin()
        );
      }

      match /reactions/{reactionId} {
        allow read: if true;
        allow create: if (
          (isAuthenticated() && (
            (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid) ||
            reactionId == request.auth.uid
          )) ||
          (!isAuthenticated() && reactionId.size() <= 128) ||
          isSuperAdmin()
        );
        allow update, delete: if (
          (isAuthenticated() && (
            resource.data.userId == request.auth.uid ||
            reactionId == request.auth.uid ||
            isSuperAdmin()
          )) ||
          (!isAuthenticated() && (
            (resource.data.userId is string && resource.data.userId.matches('^guest_.*')) ||
            reactionId.matches('^guest_.*')
          ))
        );
      }

      match /replies/{replyId} {
        allow read: if true;
        allow create: if (
          (isAuthenticated() && (
            ('authorId' in request.resource.data && request.resource.data.authorId == request.auth.uid) ||
            ('userId' in request.resource.data && request.resource.data.userId == request.auth.uid)
          )) ||
          (!isAuthenticated() && (
            ('authorId' in request.resource.data && request.resource.data.authorId is string && request.resource.data.authorId.size() > 0 && request.resource.data.authorId.size() <= 128) ||
            ('userId' in request.resource.data && request.resource.data.userId is string && request.resource.data.userId.size() > 0 && request.resource.data.userId.size() <= 128)
          )) ||
          isSuperAdmin()
        ) && isValidOptionalString('content', 0, 5000);

        allow update: if (
          (
            isAuthenticated() &&
            (('authorId' in resource.data && isOwner(resource.data.authorId)) ||
             ('userId' in resource.data && isOwner(resource.data.userId))) &&
            areImmutableFieldsUnchanged(['authorId', 'userId', 'createdAt']) &&
            isValidOptionalString('content', 0, 5000)
          ) ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likesCount', 'signals', 'signalsCount']) &&
            isValidOptionalList('likes', 1000) &&
            isValidOptionalList('signals', 1000)
          ) ||
          isSuperAdmin()
        );

        allow delete: if (
          (isAuthenticated() && (
            ('authorId' in resource.data && isOwner(resource.data.authorId)) ||
            ('userId' in resource.data && isOwner(resource.data.userId))
          )) ||
          (!isAuthenticated() && (
            ('authorId' in resource.data && resource.data.authorId is string && resource.data.authorId.matches('^guest_.*')) ||
            ('userId' in resource.data && resource.data.userId is string && resource.data.userId.matches('^guest_.*'))
          )) ||
          isSuperAdmin()
        );
      }

      match /likes/{likeId} {
        allow read: if true;
        allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || likeId == request.auth.uid);
        allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || likeId == request.auth.uid || isSuperAdmin());
      }
    }

    // ===============================================================
    // 8. WEBRTC CALLS & CALL HISTORY
    // ===============================================================
    match /calls/{callId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.callerId ||
        request.auth.uid == resource.data.receiverId ||
        isSuperAdmin()
      );
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.callerId ||
        request.auth.uid == request.resource.data.receiverId
      );
      allow update: if isAuthenticated() && (
        ((request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.receiverId) &&
         areImmutableFieldsUnchanged(['callerId', 'createdAt'])) ||
        isSuperAdmin()
      );
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.callerId ||
        request.auth.uid == resource.data.receiverId ||
        isSuperAdmin()
      );

      match /iceCandidates/{candidateId} {
        allow read, write: if isAuthenticated() && (
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId ||
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.receiverId ||
          isSuperAdmin()
        );
      }

      match /sdp/{sdpId} {
        allow read, write: if isAuthenticated() && (
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId ||
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.receiverId ||
          isSuperAdmin()
        );
      }
    }

    match /callHistory/{historyId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.callerId ||
        request.auth.uid == resource.data.receiverId ||
        request.auth.uid == resource.data.from ||
        request.auth.uid == resource.data.to ||
        isSuperAdmin()
      );
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.callerId ||
        request.auth.uid == request.resource.data.receiverId ||
        request.auth.uid == request.resource.data.from ||
        request.auth.uid == request.resource.data.to
      );
      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.callerId ||
        request.auth.uid == resource.data.receiverId ||
        request.auth.uid == resource.data.from ||
        request.auth.uid == resource.data.to ||
        isSuperAdmin()
      );
    }

    // ===============================================================
    // 9. CHANNELS, POSTS & SUBSCRIBERS
    // ===============================================================
    match /channels/{channelId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidChannelCreate(request.resource.data);
      allow update: if isAuthenticated() && (
        (
          (resource.data.creatorId == request.auth.uid || isSuperAdmin()) &&
          areImmutableFieldsUnchanged(['creatorId', 'createdAt']) &&
          isValidChannelUpdate()
        ) ||
        (
          areImmutableFieldsUnchanged(['creatorId', 'createdAt', 'name', 'handle', 'description', 'avatar', 'profilePic', 'icon', 'creatorName', 'isVerified', 'isPublic']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subscriberCount', 'followerCount']) &&
          (!('subscriberCount' in request.resource.data) || (request.resource.data.subscriberCount is number && request.resource.data.subscriberCount >= 0)) &&
          (!('followerCount' in request.resource.data) || (request.resource.data.followerCount is number && request.resource.data.followerCount >= 0))
        )
      );
      allow delete: if isAuthenticated() && (resource.data.creatorId == request.auth.uid || isSuperAdmin());

      match /posts/{postId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && isValidPostCreate(request.resource.data, channelId);
        allow update: if isAuthenticated() && (
          (
            (
              (exists(/databases/$(database)/documents/channels/$(channelId)) &&
               get(/databases/$(database)/documents/channels/$(channelId)).data.creatorId == request.auth.uid) ||
              resource.data.authorId == request.auth.uid ||
              isSuperAdmin()
            ) &&
            areImmutableFieldsUnchanged(['authorId', 'createdAt', 'channelId']) &&
            isValidOptionalString('text', 0, 10000) &&
            isValidOptionalString('content', 0, 10000)
          ) ||
          (
            areImmutableFieldsUnchanged(['authorId', 'createdAt', 'channelId', 'text', 'content', 'image', 'imageUrl', 'mediaUrl', 'authorName']) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'likes'])
          )
        );
        allow delete: if isAuthenticated() && (
          (exists(/databases/$(database)/documents/channels/$(channelId)) &&
           get(/databases/$(database)/documents/channels/$(channelId)).data.creatorId == request.auth.uid) ||
          resource.data.authorId == request.auth.uid ||
          isSuperAdmin()
        );
      }

      match /subscribers/{userId} {
        allow read: if isAuthenticated();
        allow create, delete: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidPostCreate(request.resource.data, '');
      allow update: if isAuthenticated() && (
        (resource.data.authorId == request.auth.uid || isSuperAdmin()) &&
        areImmutableFieldsUnchanged(['authorId', 'createdAt']) &&
        isValidOptionalString('text', 0, 10000) &&
        isValidOptionalString('content', 0, 10000)
      );
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isSuperAdmin());
    }

    match /subscribers/{userId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // ===============================================================
    // 10. DEVICE LINKING SESSIONS & TOKENS
    // ===============================================================
    match /link_sessions/{sessionId} {
      allow read: if true;
      allow create: if request.resource.data.status == 'pending' &&
                       isValidLinkSessionCreate(request.resource.data, sessionId);
      allow update: if isAuthenticated() && (
        ('primaryUid' in request.resource.data && request.resource.data.primaryUid == request.auth.uid) ||
        ('uid' in request.resource.data && request.resource.data.uid == request.auth.uid) ||
        ('primaryUid' in resource.data && resource.data.primaryUid == request.auth.uid) ||
        ('uid' in resource.data && resource.data.uid == request.auth.uid) ||
        (resource.data.status == 'pending' && request.resource.data.status in ['rejected', 'expired']) ||
        isSuperAdmin()
      );
      allow delete: if (isAuthenticated() && (
        ('primaryUid' in resource.data && resource.data.primaryUid == request.auth.uid) ||
        ('uid' in resource.data && resource.data.uid == request.auth.uid)
      )) ||
      (resource.data.expiresAt is int && resource.data.expiresAt <= request.time.toMillis()) ||
      isSuperAdmin();

      match /authorized_extensions/{extensionId} {
        allow read, write: if isAuthenticated();
      }
    }

    match /linked_device_tokens/{tokenId} {
      allow read: if true;
      allow create: if request.resource.data.isUsed == false || request.resource.data.status == 'pending';
      allow update: if isAuthenticated() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isUsed', 'consumedAt', 'status']) &&
        isValidOptionalString('status', 0, 50)
      );
      allow delete: if isAuthenticated() || isSuperAdmin();
    }

    // ===============================================================
    // 11. ADVERTISEMENTS & MARKETPLACE
    // ===============================================================
    match /advertisements/{adId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
                       request.resource.data.sellerUID == request.auth.uid &&
                       isValidAdvertisement(request.resource.data);
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          request.auth.uid == resource.data.sellerUID &&
          areImmutableFieldsUnchanged(['sellerUID', 'createdAt']) &&
          isValidAdvertisement(request.resource.data)
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) &&
          request.resource.data.views is number &&
          request.resource.data.views >= resource.data.views
        )
      );
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.sellerUID ||
        isSuperAdmin()
      );
    }

    // ===============================================================
    // 12. TOKENS, GIFTS & TRANSACTIONS
    // ===============================================================
    match /tokenGifts/{giftId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.senderId ||
        request.auth.uid == resource.data.recipientId ||
        isSuperAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (request.auth.uid == resource.data.recipientId &&
         resource.data.status == 'pending' &&
         request.resource.data.status in ['accepted', 'declined'] &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt', 'declinedAt', 'updatedAt'])) ||
        (request.auth.uid == resource.data.senderId &&
         resource.data.status == 'pending' &&
         request.resource.data.status == 'cancelled' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'updatedAt'])) ||
        isSuperAdmin()
      );
      allow delete: if isSuperAdmin();
    }

    match /transactions/{txId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        isSuperAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSuperAdmin();
    }

    // ===============================================================
    // 13. CREATOR BADGES & NEARBY RADAR
    // ===============================================================
    match /creator_badges/{badgeId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          (
            ('claimedBy' in request.resource.data && request.resource.data.claimedBy == request.auth.uid) ||
            ('userId' in request.resource.data && request.resource.data.userId == request.auth.uid) ||
            ('ownerId' in request.resource.data && request.resource.data.ownerId == request.auth.uid) ||
            ('holders' in request.resource.data && request.resource.data.holders is list && request.auth.uid in request.resource.data.holders) ||
            badgeId.matches('.*' + request.auth.uid + '.*')
          ) &&
          isValidCreatorBadge()
        )
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['minted', 'holders', 'claimedBy', 'claimants', 'lastClaimedAt', 'lastClaimedBy']) &&
          isValidCreatorBadge()
        ) ||
        (
          areImmutableFieldsUnchanged(['title', 'name', 'price', 'rarity', 'createdAt']) &&
          (
            ('claimedBy' in request.resource.data && request.resource.data.claimedBy == request.auth.uid) ||
            ('userId' in request.resource.data && request.resource.data.userId == request.auth.uid)
          ) &&
          isValidCreatorBadge()
        )
      );
      allow delete: if isSuperAdmin();
    }

    match /nearby_radar/{uid} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
                               isOwner(uid) &&
                               request.resource.data.uid == request.auth.uid &&
                               isValidNearbyRadar(request.resource.data, uid);
      allow delete: if isAuthenticated() && (isOwner(uid) || isSuperAdmin());
    }

    // ===============================================================
    // 14. VIDEOS & MESSAGE ACTIVITY
    // ===============================================================
    match /videos/{videoId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.authorId ||
        isSuperAdmin()
      );
    }

    match /messageActivity/{activityId} {
      allow create: if isAuthenticated() && (
        request.resource.data.senderId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
      allow read: if isAuthenticated() && (
        ('senderId' in resource.data && resource.data.senderId == request.auth.uid) ||
        ('userId' in resource.data && resource.data.userId == request.auth.uid) ||
        isSuperAdmin()
      );
      allow update, delete: if isSuperAdmin();
    }

    // ===============================================================
    // 15. REPORTS & ANNOUNCEMENTS
    // ===============================================================
    match /reports/{reportId} {
      allow create: if isAuthenticated() && isValidReport(request.resource.data);
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.reportedBy ||
        isSuperAdmin()
      );
      allow update, delete: if isSuperAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /system_announcements/{announcementId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ===============================================================
    // 16. SYSTEM CONFIG, SETTINGS & ADMIN AUDIT / SECURITY
    // ===============================================================
    match /system_config/{configId} {
      allow read: if isSuperAdmin() ||
                     configId in [
                       'reels_algorithm',
                       'maintenance',
                       'maintenance_mode',
                       'client_feature_flags',
                       'feature_flags',
                       'featureFlags',
                       'client_features',
                       'clientFeatureFlags',
                       'features'
                     ] ||
                     configId.matches('.*feature.*') ||
                     configId.matches('.*maintenance.*') ||
                     configId.matches('.*algorithm.*');
      allow write: if isSuperAdmin();
    }

    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /ip_registrations/{ipKey} {
      allow read, write: if isSuperAdmin();
    }

    match /admin_audit_logs/{logId} {
      allow read, write: if isSuperAdmin();
    }

    match /admin_security/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // ===============================================================
    // 16B. CYBER-SUITE & EXTENDED CHAT PROTOCOL COLLECTIONS
    // ===============================================================
    match /presence/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
    }

    match /nexbot_configs/{configId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.resource.data.authorId == request.auth.uid || request.resource.data.userId == request.auth.uid || isSuperAdmin());
      allow update, delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || resource.data.userId == request.auth.uid || isSuperAdmin());
    }

    match /security_scan_logs/{logId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isSuperAdmin());
      allow update, delete: if isSuperAdmin();
    }

    match /quarantine_vault/{vaultId} {
      allow read, write: if isAuthenticated() && (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isSuperAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
    }

    match /call_sessions/{callId} {
      allow read, update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.callerId ||
        request.auth.uid == resource.data.receiverId ||
        ('participants' in resource.data && request.auth.uid in resource.data.participants) ||
        isSuperAdmin()
      );
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.callerId ||
        request.auth.uid == request.resource.data.receiverId ||
        ('participants' in request.resource.data && request.auth.uid in request.resource.data.participants) ||
        isSuperAdmin()
      );
      match /iceCandidates/{candidateId} {
        allow read, write: if isAuthenticated();
      }
      match /sdp/{sdpId} {
        allow read, write: if isAuthenticated();
      }
      match /participants/{participantId} {
        allow read, write: if isAuthenticated();
      }
    }

    match /groupCalls/{groupCallId} {
      allow read, write: if isAuthenticated();
      match /participants/{participantId} {
        allow read, write: if isAuthenticated();
      }
    }

    match /tokens/{tokenId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || tokenId == request.auth.uid || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    match /vip_licenses/{licenseId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || licenseId == request.auth.uid || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    match /tokenTransactions/{txId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.recipientId || isSuperAdmin());
      allow create: if isAuthenticated() && (request.resource.data.senderId == request.auth.uid || isSuperAdmin());
      allow update, delete: if isSuperAdmin();
    }

    match /paymentHistory/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    match /escrow_contracts/{contractId} {
      allow read: if isAuthenticated() && (
        resource.data.buyer == request.auth.uid ||
        resource.data.seller == request.auth.uid ||
        ('buyerUID' in resource.data && resource.data.buyerUID == request.auth.uid) ||
        ('sellerUID' in resource.data && resource.data.sellerUID == request.auth.uid) ||
        isSuperAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.buyer == request.auth.uid ||
        resource.data.seller == request.auth.uid ||
        ('buyerUID' in resource.data && resource.data.buyerUID == request.auth.uid) ||
        ('sellerUID' in resource.data && resource.data.sellerUID == request.auth.uid) ||
        isSuperAdmin()
      );
      allow delete: if isSuperAdmin();
    }

    match /scheduled_messages/{messageId} {
      allow read, update, delete: if isAuthenticated() && (resource.data.senderId == request.auth.uid || resource.data.from == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && (request.resource.data.senderId == request.auth.uid || request.resource.data.from == request.auth.uid || isSuperAdmin());
    }

    match /dead_drops/{dropId} {
      allow read, write: if isAuthenticated() || isSuperAdmin();
    }

    match /spamReports/{reportId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    // ===============================================================
    // 17. ZERO-TRUST DEFAULT DENY BARRIER
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
