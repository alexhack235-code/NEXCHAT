# AI Configuration
AI_PROVIDER=openai
OPENAI_API_KEY=your_api_key_here
USE_REAL_AI=True
ENABLE_VISION=True
PORT=5000
DEBUG=True
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1000

# Vercel Blob Storage Tokens
BLOB_READ_WRITE_TOKEN_PROFILE=
BLOB_READ_WRITE_TOKEN_MEDIA=
BLOB_READ_WRITE_TOKEN=

# NEX-REELS Multi-Vault Storage Tokens (Vaults 0 - 5)
BLOB_READ_WRITE_TOKEN_REELS_VAULT_0=
BLOB_READ_WRITE_TOKEN_REELS_VAULT_1=
BLOB_READ_WRITE_TOKEN_REELS_VAULT_2=
BLOB_READ_WRITE_TOKEN_REELS_VAULT_3=
BLOB_READ_WRITE_TOKEN_REELS_VAULT_4=
BLOB_READ_WRITE_TOKEN_REELS_VAULT_5=

# NEX-STATUS Multi-Vault Storage Tokens (Vaults 1 - 5)
BLOB_READ_WRITE_TOKEN_STATUS_VAULT_1=
BLOB_READ_WRITE_TOKEN_STATUS_VAULT_2=
BLOB_READ_WRITE_TOKEN_STATUS_VAULT_3=
BLOB_READ_WRITE_TOKEN_STATUS_VAULT_4=
BLOB_READ_WRITE_TOKEN_STATUS_VAULT_5=

# Cloudinary Unsigned Upload
CLOUDINARY_CLOUD_NAME=kkiyeyj8
CLOUDINARY_UPLOAD_PRESET=ml_default
