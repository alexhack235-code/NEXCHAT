# ChronEX AI Configuration (Google Gemini Pro & OpenAI)
AI_PROVIDER=gemini
GEMINI_API_KEY_1=your_first_gemini_api_key_here
GEMINI_API_KEY_2=your_second_gemini_api_key_here
GEMINI_API_KEYS=key1,key2
OPENAI_API_KEY=your_openai_api_key_here
USE_REAL_AI=True
ENABLE_VISION=True
PORT=5000
DEBUG=True
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048

# --- VERCEL BLOB STORAGE: 5 PUBLIC VAULTS ---
BLOB_READ_WRITE_TOKEN_PUBLIC_1=
BLOB_READ_WRITE_TOKEN_PUBLIC_2=
BLOB_READ_WRITE_TOKEN_PUBLIC_3=
BLOB_READ_WRITE_TOKEN_PUBLIC_4=
