{
  "name": "nexchat",
  "version": "1.0.0",
  "type": "module",
  "description": "NEXCHAT - Modern chat application",
  "main": "index.html",
  "scripts": {
    "dev": "vite",
    "build": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "dist:prep": "python scripts/prepare_dist.py",
    "android:icons": "powershell -ExecutionPolicy Bypass -File scripts/generate_android_icons.ps1",
    "android:build": "scripts\\build-android-apk.bat",
    "android:sync": "node ./node_modules/@capacitor/cli/bin/capacitor sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@vercel/blob": "^2.8.0",
    "clsx": "^2.1.1",
    "firebase": "^9.23.0",
    "framer-motion": "^11.11.17",
    "gsap": "^3.15.0",
    "idb": "^8.0.3",
    "lenis": "^1.3.26",
    "lucide-react": "^0.454.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "vite": "^4.4.0"
  }
}
