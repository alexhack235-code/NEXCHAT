{
  "database": {
    "rules": "database.rules.json"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "api/**",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/chat",
        "destination": "/chat.html"
      },
      {
        "source": "/reels",
        "destination": "/reels.html"
      },
      {
        "source": "/gaminghub",
        "destination": "/gaminghub.html"
      },
      {
        "source": "/terminal",
        "destination": "/terminal.html"
      },
      {
        "source": "/landing",
        "destination": "/landing.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}