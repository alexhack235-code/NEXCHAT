rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ============================================================
    // HELPER SECURITY FUNCTIONS
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isGroupMember(groupId) {
      return isAuthenticated() &&
             firestore.exists(/databases/(default)/documents/groups/$(groupId)) &&
             request.auth.uid in firestore.get(/databases/(default)/documents/groups/$(groupId)).data.members;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'demonalexander526@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    // ============================================================
    // 1. AVATAR UPLOADS (Profile Pictures)
    // ============================================================
    match /avatars/{userId}/{allPaths=**} {
      allow create, write: if isOwner(userId) &&
                              request.resource.size < 10 * 1024 * 1024 &&
                              request.resource.contentType.matches('image/.*');
      allow read: if true;
      allow delete: if isOwner(userId) || isSuperAdmin();
    }

    match /avatars/{fileName} {
      allow create, write: if isAuthenticated() &&
                              request.resource.size < 10 * 1024 * 1024 &&
                              request.resource.contentType.matches('image/.*');
      allow read: if true;
      allow delete: if isAuthenticated() || isSuperAdmin();
    }

    // ============================================================
    // 2. REELS & CLIPS (Short Video Engine & Highlights)
    // ============================================================
    match /reels/{allPaths=**} {
      allow create, write: if isAuthenticated() &&
                              request.resource.size < 150 * 1024 * 1024 &&
                              (request.resource.contentType.matches('video/.*') ||
                               request.resource.contentType.matches('image/.*') ||
                               request.resource.contentType.matches('audio/.*'));
      allow read: if true;
      allow delete: if isAuthenticated() || isSuperAdmin();
    }

    match /clips/{allPaths=**} {
      allow create, write: if isAuthenticated() &&
                              request.resource.size < 150 * 1024 * 1024 &&
                              request.resource.contentType.matches('video/.*');
      allow read: if true;
      allow delete: if isAuthenticated() || isSuperAdmin();
    }

    // ============================================================
    // 3. STATUS STORIES & UPDATES
    // ============================================================
    match /status/{allPaths=**} {
      allow create, write: if isAuthenticated() &&
                              request.resource.size < 30 * 1024 * 1024 &&
                              (request.resource.contentType.matches('image/.*') ||
                               request.resource.contentType.matches('video/.*'));
      allow read: if true;
      allow delete: if isAuthenticated() || isSuperAdmin();
    }

    match /statuses/{allPaths=**} {
      allow create, write: if isAuthenticated() &&
                              request.resource.size < 30 * 1024 * 1024 &&
                              (request.resource.contentType.matches('image/.*') ||
                               request.resource.contentType.matches('video/.*'));
      allow read: if true;
      allow delete: if isAuthenticated() || isSuperAdmin();
    }

    // ============================================================
    // 4. CHAT ATTACHMENTS & DIRECT MESSAGES MEDIA
    // ============================================================
    match /shared/{allPaths=**} {
      allow create, write: if isAuthenticated() &&
                              request.resource.size < 100 * 1024 * 1024;
      allow read: if isAuthenticated();
      allow delete: if isAuthenticated() || isSuperAdmin();
    }

    match /attachments/{allPaths=**} {
      allow create, write: if isAuthenticated() &&
                              request.resource.size < 100 * 1024 * 1024;
      allow read: if isAuthenticated();
      allow delete: if isAuthenticated() || isSuperAdmin();
    }

    match /chats/{allPaths=**} {
      allow create, write: if isAuthenticated() &&
                              request.resource.size < 100 * 1024 * 1024;
      allow read: if isAuthenticated();
      allow delete: if isAuthenticated() || isSuperAdmin();
    }

    match /audio/{allPaths=**} {
      allow create, write: if isAuthenticated() &&
                              request.resource.size < 50 * 1024 * 1024 &&
                              request.resource.contentType.matches('audio/.*');
      allow read: if isAuthenticated();
      allow delete: if isAuthenticated() || isSuperAdmin();
    }

    match /documents/{allPaths=**} {
      allow create, write: if isAuthenticated() &&
                              request.resource.size < 50 * 1024 * 1024;
      allow read: if isAuthenticated();
      allow delete: if isAuthenticated() || isSuperAdmin();
    }

    // ============================================================
    // 5. GROUP MEDIA & DOCUMENTS
    // ============================================================
    match /groups/{allPaths=**} {
      allow create, write: if isAuthenticated() &&
                              request.resource.size < 100 * 1024 * 1024;
      allow read: if isAuthenticated();
      allow delete: if isAuthenticated() || isSuperAdmin();
    }

    match /groupdocs/{allPaths=**} {
      allow create, write: if isAuthenticated() &&
                              request.resource.size < 50 * 1024 * 1024;
      allow read: if isAuthenticated();
      allow delete: if isAuthenticated() || isSuperAdmin();
    }

    // ============================================================
    // 6. BACKGROUNDS & WALLPAPERS
    // ============================================================
    match /backgrounds/{allPaths=**} {
      allow create, write: if isAuthenticated() &&
                              request.resource.size < 10 * 1024 * 1024 &&
                              request.resource.contentType.matches('image/.*');
      allow read: if true;
      allow delete: if isAuthenticated() || isSuperAdmin();
    }

    // ============================================================
    // 7. ADVERTISEMENTS & SHOWCASE MEDIA
    // ============================================================
    match /advertisements/{allPaths=**} {
      allow create, write: if isAuthenticated() &&
                              request.resource.size < 10 * 1024 * 1024 &&
                              request.resource.contentType.matches('image/.*');
      allow read: if true;
      allow delete: if isAuthenticated() || isSuperAdmin();
    }

    match /ads/{allPaths=**} {
      allow create, write: if isAuthenticated() &&
                              request.resource.size < 10 * 1024 * 1024 &&
                              request.resource.contentType.matches('image/.*');
      allow read: if true;
      allow delete: if isAuthenticated() || isSuperAdmin();
    }

    // ============================================================
    // 8. TEMPORARY TRANSFERS & ENCODING
    // ============================================================
    match /temp/{allPaths=**} {
      allow create, write: if isAuthenticated() &&
                              request.resource.size < 100 * 1024 * 1024;
      allow read: if isAuthenticated();
      allow delete: if isAuthenticated() || isSuperAdmin();
    }

    // ============================================================
    // 9. PUBLIC ASSETS & BRANDING
    // ============================================================
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ============================================================
    // 10. SYSTEM & ADMIN LOGS
    // ============================================================
    match /admin/{allPaths=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}